<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A1B2C3D4-0003-4E5F-9A2B-000000000003}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Core.Licensing</RootNamespace>
    <AssemblyName>Core.Licensing</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fingerprint collection (Phase 1) -->
    <Compile Include="Fingerprint\HardwareFingerprint.cs" />
    <Compile Include="Fingerprint\FingerprintCollector.cs" />
    <!-- Signing / verification core (Phase 2) -->
    <Compile Include="Signing\LicenseData.cs" />
    <Compile Include="Signing\RsaKeyPairGenerator.cs" />
    <Compile Include="Signing\LicenseSigner.cs" />
    <Compile Include="Signing\LicenseVerifier.cs" />
    <Compile Include="Signing\LicensePublicKey.cs" />
    <!-- License file storage (Phase 3) -->
    <Compile Include="Storage\LicenseStorage.cs" />
    <!-- Startup validation flow (Phase 5) -->
    <Compile Include="Validation\LicenseStatus.cs" />
    <Compile Include="Validation\LicenseValidator.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!--
      Obfuscation (Licensing-Plan.md, Phase 6) — Release builds only,
      scoped to this assembly (see Obfuscation\Core.Licensing.crproj for
      why not PosSystem.App.exe). Deliberately opt-in rather than
      required: if ConfuserEx's CLI isn't present at the expected path,
      this just logs a message and the plain (unobfuscated) DLL is what
      ships — so a machine without the tool installed (e.g. GitHub
      Actions CI today) still gets a working Release build, just not an
      obfuscated one, instead of a hard build failure.

      $(SolutionDir) is only reliably populated when MSBuild is invoked
      against PosSystem.sln (as both local Release builds and
      build-demo.yml's CI already do) — building this .csproj directly,
      outside the solution, will leave it empty and just skip this step,
      which is a safe failure mode here (falls back to "no obfuscation"),
      not a broken one.

      SETUP (one-time, per machine that should actually obfuscate):
      download the ConfuserEx CLI (mkaring/ConfuserEx releases on GitHub,
      since the original yck1509/ConfuserEx is archived) and place
      Confuser.CLI.exe at \tools\ConfuserEx\Confuser.CLI.exe at the repo
      root. Never commit the tool itself — see .gitignore.
  -->
  <PropertyGroup>
    <ConfuserExPath>$(SolutionDir)tools\ConfuserEx\Confuser.CLI.exe</ConfuserExPath>
  </PropertyGroup>
  <Target Name="ObfuscateReleaseBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Message Importance="high"
             Condition="!Exists('$(ConfuserExPath)')"
             Text="Core.Licensing: obfuscation skipped — ConfuserEx CLI not found at $(ConfuserExPath). Plain (unobfuscated) DLL was built. See Licensing-Plan.md, Phase 6, for one-time setup." />
    <Exec Condition="Exists('$(ConfuserExPath)')"
          Command="&quot;$(ConfuserExPath)&quot; &quot;$(ProjectDir)Obfuscation\Core.Licensing.crproj&quot;" />
    <Message Importance="high"
             Condition="Exists('$(ConfuserExPath)')"
             Text="Core.Licensing: obfuscated build written to $(ProjectDir)bin\Release\Obfuscated\Core.Licensing.dll — this is the copy that should ship, not the plain one in bin\Release\ directly. See Licensing-Plan.md, Phase 6." />
  </Target>
</Project>
