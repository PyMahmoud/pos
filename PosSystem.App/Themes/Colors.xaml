<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Placeholder palette using Material-You-style semantic naming
        (role-based tokens, not raw color names) so swapping the actual
        brand color later only means editing this file, not every screen.
        Replace these hex values with your real brand seed color +
        generated tonal palette when ready.
    -->

    <Color x:Key="PrimaryColor">#6750A4</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="PrimaryContainerColor">#EADDFF</Color>
    <Color x:Key="OnPrimaryContainerColor">#21005D</Color>

    <Color x:Key="SecondaryColor">#625B71</Color>
    <Color x:Key="OnSecondaryColor">#FFFFFF</Color>

    <Color x:Key="SurfaceColor">#FFFBFE</Color>
    <Color x:Key="OnSurfaceColor">#1C1B1F</Color>
    <Color x:Key="SurfaceVariantColor">#E7E0EC</Color>

    <Color x:Key="ErrorColor">#B3261E</Color>
    <Color x:Key="OnErrorColor">#FFFFFF</Color>

    <Color x:Key="OutlineColor">#79747E</Color>

    <!-- Brushes (what XAML actually binds to) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainerColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="OnSecondaryBrush" Color="{StaticResource OnSecondaryColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="OnErrorBrush" Color="{StaticResource OnErrorColor}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}" />

</ResourceDictionary>
