<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Nav rail item: icon + label, rounded highlight when selected.
        Applied as the ItemContainerStyle on the sidebar ListBox in
        MainWindow.xaml. Uses only theme brush keys, so it repaints
        correctly under both Colors.Light.xaml and Colors.Dark.xaml.
    -->
    <Style x:Key="NavListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="IconPath"
                                  Data="{Binding IconData}"
                                  Fill="{DynamicResource OnSurfaceVariantBrush}"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock x:Name="LabelText"
                                       Text="{Binding Label}"
                                       Style="{StaticResource BodyLarge}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimaryContainerBrush}" />
                            <Setter TargetName="IconPath" Property="Fill" Value="{DynamicResource OnPrimaryContainerBrush}" />
                            <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource OnPrimaryContainerBrush}" />
                            <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Theme toggle button (sidebar footer). Replaces the default WPF
        Button template, which paints its own fixed system hover/pressed
        colors that ignore Background/Foreground — that's why the old
        version looked fine in light mode but was unreadable in dark
        mode. This version uses only theme brush keys, so hover/pressed
        stay legible under both Colors.Light.xaml and Colors.Dark.xaml.
    -->
    <Style x:Key="ThemeToggleButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{DynamicResource SurfaceContainerBrush}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimaryContainerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>