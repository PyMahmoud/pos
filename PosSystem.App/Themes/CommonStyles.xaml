<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:PosSystem.App.Behaviors">

    <!--
        Shared form-control styles used by more than one screen (currently
        Customers' add-customer form + search box, and Checkout's customer
        picker). Checkout's existing search TextBox predates this file and
        sets its brushes inline instead — left as-is rather than retrofitted,
        since it already works and touching it risks nothing being gained.
        New TextBox/ComboBox usage from here on should use these instead of
        repeating the same five setters inline.
    -->

    <!--
        Background is SurfaceContainerHigh (not the same SurfaceContainer
        several card/panel backgrounds already use) plus a real border, so
        this never silently blends into whatever it's placed on — the first
        version used SurfaceContainerBrush with BorderThickness 0, which was
        invisible on the Customers screen's payment cards (same brush as the
        card itself, so a typed amount just floated with no box around it).
        Border brightens to Primary on focus so it's obvious which field is
        active.
    -->
    <!--
        Same visual shape as ThemedTextBoxStyle above, but PasswordBox is
        not a TextBox subtype in WPF (no shared base for this), so it needs
        its own style rather than reusing that one. Added 2026-08-27 for
        the Dashboard admin-password unlock screen and Settings' admin-
        password fields.
    -->
    <Style x:Key="ThemedPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighestBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighestBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Full ControlTemplate override, added 2026-08-24 (previously
        setters-only, see round-4/round-5 history in Dashboard-Parity-Plan.md
        for the same pattern applied to DatePicker). Setters-only theming
        only reaches the closed box — Background/Foreground/BorderBrush on
        ComboBox itself — because the dropdown popup, its background, and
        each ComboBoxItem's hover/selection colors are owned by the stock
        template's own Border/Popup/highlight brushes, which setters can't
        reach. That's exactly what Mahmoud's screenshot showed: a themed
        closed box opening onto a plain white system dropdown list.

        Standard, widely-documented ComboBox part contract (the classic
        "override a ComboBox template" shape — not obscure or
        library-specific like the LiveCharts risk elsewhere in this
        project): the only element ComboBox's OnApplyTemplate looks up BY
        NAME is "PART_Popup" (a Popup); everything else (the toggle button,
        the selection ContentPresenter) just needs correct Bindings/
        TemplateBindings, not a specific name, since the standard
        IsDropDownOpen TwoWay-bound ToggleButton pattern below is how the
        control actually opens/closes — not name-based wiring like
        DatePicker's PART_Button.
    -->
    <Style x:Key="ThemedComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ContentSite"
                                                  Grid.Column="0"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" />
                                <!--
                                    Only reached when IsEditable=True (Inventory's
                                    category ComboBox, added for Add Product's
                                    type-to-search category field — see
                                    InventoryViewModel's class doc comment).
                                    Standard WPF part-contract name for this:
                                    ComboBox looks up "PART_EditableTextBox" by
                                    name and, if present, wires it up as the
                                    in-place text-entry surface when editable;
                                    if IsEditable is left False (every other
                                    ComboBox in the app today — Checkout's
                                    customer picker, CustomerDetail's medication
                                    picker), the trigger below never fires, this
                                    stays Collapsed, and rendering is pixel-for-
                                    pixel identical to before this was added.
                                -->
                                <TextBox x:Name="PART_EditableTextBox"
                                         Grid.Column="0"
                                         Visibility="Collapsed"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{TemplateBinding Foreground}"
                                         CaretBrush="{TemplateBinding Foreground}"
                                         Focusable="True"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"
                                         Margin="{TemplateBinding Padding}"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" />
                                <ToggleButton x:Name="ToggleButton"
                                              Grid.Column="1"
                                              Width="34" Height="28"
                                              Margin="0,0,4,0"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ButtonChrome"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8">
                                                <Path Data="M2,3 L8,9 L14,3"
                                                      Stroke="{DynamicResource OnSurfaceVariantBrush}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Width="14" Height="9"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder"
                                    Background="{DynamicResource SurfaceContainerHighestBrush}"
                                    BorderBrush="{DynamicResource OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer SnapsToDevicePixels="True" Padding="4">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <!-- Swap ContentSite → PART_EditableTextBox when this
                             ComboBox is editable — see the TextBox comment
                             above for why this only ever affects Inventory's
                             category field, not any existing ComboBox. -->
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Implicit (key-less) ComboBoxItem style, so every row inside the
        dropdown above is themed automatically — same mechanism as the
        implicit DatePickerTextBox style below reaching PART_TextBox inside
        ThemedDatePickerStyle. IsHighlighted (distinct from IsMouseOver) is
        the real WPF property for "this row has keyboard/mouse focus while
        the dropdown is open" — what the stock template shows as a blue bar,
        themed here to SurfaceContainerHighBrush/PrimaryBrush instead.
    -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="6"
                            Margin="4,2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Implicit (key-less) ScrollBar style, added 2026-08-24 alongside the
        ComboBox fix above — same complaint, same root cause: nothing in the
        app had ever styled ScrollBar, so every scrollbar (Checkout's item
        browser, Checkout's cart, and now the ComboBox dropdown above) sat
        on stock Windows chrome regardless of theme.

        Deliberately themes ScrollBar itself rather than overriding
        ScrollViewer's own template: the stock ScrollViewer template
        instantiates its scrollbars with Style="{DynamicResource
        {x:Type ScrollBar}}" internally, so a key-less style for ScrollBar
        here reaches every ScrollViewer in the app automatically — including
        ones this file has no XAML changes to and never touches directly.
        Rewriting ScrollViewer's own template instead would mean correctly
        reproducing ITS part contract too (PART_VerticalScrollBar,
        PART_HorizontalScrollBar, PART_ScrollContentPresenter, PART_Track on
        each ScrollBar again) for zero extra benefit — more risk, same
        result. Track requires the name "PART_Track" exactly (ScrollBar's
        one required named part); DecreaseRepeatButton/Thumb/
        IncreaseRepeatButton don't need names, just the correct Command/
        Style wiring shown below — this is the standard, widely-reused
        "thin themed scrollbar" shape, not unusual API surface.
    -->
    <!--
        Confirmed root cause (2026-08-25): the real ScrollBar template below
        now uses behaviors:MinLengthTrack instead of the stock Track — that
        was the actual fix. This diagnostic Border WAS the thing rendering
        every scrollbar (that question is answered), so reverted here to the
        real themed appearance rather than left red.
    -->
    <Style x:Key="ThemedScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource OutlineVariantBrush}" CornerRadius="7" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="16" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <behaviors:MinLengthTrack x:Name="PART_Track"
                               IsDirectionReversed="True"
                               MinThumbLength="80"
                               Width="14"
                               HorizontalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ThemedScrollBarPageButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ThemedScrollBarPageButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThemedScrollBarThumb}" Width="14" />
                            </Track.Thumb>
                        </behaviors:MinLengthTrack>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!--
            Neither this Setter nor Track.Thumb's old MinHeight="260" (the
            2026-08-24 attempt this replaced) ever actually controlled the
            rendered thumb size, for the same underlying reason: stock
            Track.ArrangeOverride computes the Thumb's Arrange rect itself
            from Minimum/Maximum/ViewportSize and calls Thumb.Arrange()
            with that rect directly — it does not read Height/MinHeight/
            MinWidth/Width off the Thumb at all when deciding what to
            Arrange it to, so setting any of them (via a Setter here, or via
            ScrollBarThumbBehavior's Thumb.Height sets, confirmed running
            correctly via its own Debug.WriteLine output) had zero effect on
            what actually rendered. Confirmed 2026-08-25 by checking the
            actual PART_Track type in this file's ScrollBar ControlTemplate:
            it was a plain stock Track, never MinLengthTrack (Behaviors\
            MinLengthTrack.cs), despite MinLengthTrack existing in the repo
            since 2026-08-24 and being exactly the correct fix — it works
            because it calls Thumb.Arrange() itself, AFTER base Track
            layout, which genuinely is authoritative (Arrange always wins
            over a mere Height/MinHeight property). The real fix is that
            PART_Track is now behaviors:MinLengthTrack (see the vertical and
            horizontal ControlTemplates below), not this Setter — removed
            since ScrollBarThumbBehavior.cs is confirmed to do nothing
            through this path. That file should be deleted; left in place
            only because this session has no file-delete capability, not
            because it's still useful — don't re-attach it to anything.
        -->
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <behaviors:MinLengthTrack x:Name="PART_Track"
                                       MinThumbLength="80"
                                       Height="14"
                                       VerticalAlignment="Center">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ThemedScrollBarPageButton}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ThemedScrollBarPageButton}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ThemedScrollBarThumb}" Height="14" />
                                    </Track.Thumb>
                                </behaviors:MinLengthTrack>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Implicit (key-less) ScrollViewer style, added 2026-08-24 alongside
        the bigger thumb above — "make its sensitivity higher" when there's
        a lot to scroll needs actual behavior code, not just a bigger
        visual, since WPF's default mouse-wheel scroll is a flat amount
        (~48px/notch) no matter how long the content is. ScrollBehavior
        .AdaptiveWheel (Behaviors\ScrollBehavior.cs) scales that per-notch
        distance up when the scrollable content is much taller than the
        viewport, so Inventory's product grid (and any other long list)
        scrolls faster per notch than a short one — capped both ends so a
        short list still feels like a normal scroll. Set here as a plain
        attached-property Setter (not an EventSetter, which would need
        code-behind on this ResourceDictionary itself — real, avoidable
        complexity for an old-style .csproj), so it reaches every
        ScrollViewer in the app the same way the ScrollBar style above
        does, including ones nested inside other controls' templates
        (ThemedComboBoxStyle's dropdown ScrollViewer, a multi-line
        TextBox's PART_ContentHost) — harmless there, since short content
        just means the scale factor stays at its 1.0 floor.
    -->
    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="behaviors:ScrollBehavior.AdaptiveWheel" Value="True" />
    </Style>

    <!--
        Dashboard date-range pickers. Originally (2026-08-24) a setters-only
        style — deliberately not a full ControlTemplate override, because
        correctly reproducing DatePicker's PART_Root/PART_Button/
        PART_TextBox/PART_Popup contract isn't verifiable without a WPF
        runtime to click through, and getting one part wrong risks silently
        breaking the calendar popup. That tradeoff meant square-ish corners
        and a plain system-chrome toggle button, which Mahmoud flagged as
        looking bad next to the rest of the app (screenshot, 2026-08-24) —
        this revision picks up that deferred risk on his explicit request.

        SCOPE, kept deliberately narrow: this restyles the outer box (Border
        chrome, rounded like every other input) and the calendar-toggle
        button (now a themed chevron instead of the plain system calendar
        glyph) — i.e. exactly what's visible/ugly in the closed-popup state
        shown in the screenshot. The POPUP CALENDAR ITSELF (the actual
        month/day grid that drops down) is deliberately left on the default
        Windows Calendar control appearance — restyling that is a much
        larger, separate risk surface (its own PART contract: CalendarItem,
        CalendarDayButton, month/year navigation buttons, etc.) that isn't
        what the screenshot complained about. Flagging this as a known,
        deliberate follow-up rather than silently leaving it half-themed —
        if the popup itself turns out to look equally out of place once
        this is actually seen open, that's a real fast-follow, not a
        surprise.

        Part-by-part mapping to the standard DatePicker contract (this is
        the exact set OnApplyTemplate looks for by name — omitting or
        misnaming any of these is what would break the control):
        - PART_Root   → the outer Grid
        - PART_TextBox → the DatePickerTextBox (date text entry)
        - PART_Button  → the calendar-toggle Button
        - PART_Popup   → the Popup DatePicker itself assigns its internal
                         Calendar into at runtime (this template does not,
                         and should not, put a Calendar inside it directly)
    -->
    <Style x:Key="ThemedDatePickerStyle" TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighestBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                    Grid.Column="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{TemplateBinding Foreground}"
                                                    Padding="{TemplateBinding Padding}"
                                                    VerticalContentAlignment="Center"
                                                    VerticalAlignment="Stretch" />
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Width="34" Height="28"
                                        Margin="0,0,4,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonChrome"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8">
                                                <Path Data="M2,3 L8,9 L14,3"
                                                      Stroke="{DynamicResource OnSurfaceVariantBrush}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Width="14" Height="9"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        <!-- DatePicker assigns its internal Calendar as this
                             Popup's Child at runtime — deliberately left
                             empty here, see class-level comment above on
                             why the popup's own appearance isn't themed in
                             this revision. -->
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=Chrome}"
                               StaysOpen="False"
                               AllowsTransparency="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        DatePickerTextBox is a genuine subtype of TextBox, not a separate
        composite control, so this implicit (key-less) style applies
        automatically wherever one renders — including the PART_TextBox
        instance inside the ControlTemplate above (its own Background/
        BorderThickness setters there win for those two properties via
        local-value precedence, but Foreground/CaretBrush/selection colors
        still come from here).
    -->
    <Style TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <!--
        Themed CheckBox, added alongside Settings' Access Control section
        (per Mahmoud's request) — the first CheckBox anywhere in this app,
        so there was no existing style to extend. Same visual language as
        the rest of this file's themed controls: an 18x18 rounded box
        (OutlineVariantBrush border, transparent fill) that switches to a
        solid PrimaryBrush fill with an OnPrimaryBrush checkmark path when
        checked, sitting next to the normal themed label text — rather
        than the default WPF CheckBox glyph, which renders in stock system
        chrome regardless of the active theme (the same category of
        mismatch ComboBox/DatePicker/ScrollBar had before each got its own
        style in this file).
    -->
    <Style x:Key="ThemedCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box"
                                Grid.Column="0"
                                Width="18" Height="18"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderBrush="{DynamicResource OutlineVariantBrush}"
                                BorderThickness="2"
                                VerticalAlignment="Center">
                            <Path x:Name="Check"
                                  Data="M2,6 L6,10 L13,2"
                                  Stroke="{DynamicResource OnPrimaryBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Margin="2"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="2"
                                           VerticalAlignment="Center"
                                           TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
