<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LIGHT theme — generated from seed color #6C4CE0 (bold violet, matching
        the Image 1 reference) using Google's own Material Design 3 color
        engine (materialyoucolor, Fidelity variant), not hand-picked values.

        Fidelity keeps the seed color true-to-source for Primary rather than
        muting it, while algorithmically deriving low-fatigue neutral surfaces
        for everything else — this is the "calm structure, bold accent"
        pairing: violet appears where staff need to notice and act
        (buttons, totals, active nav), neutrals carry the rest of the screen.

        Same token names exist in Colors.Dark.xaml. Screens/styles should only
        ever reference the *Brush keys below — never a raw hex — so the whole
        app repaints correctly when ThemeManager swaps this dictionary out.
    -->

    <Color x:Key="PrimaryColor">#532EC7</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="PrimaryContainerColor">#6C4CE0</Color>
    <Color x:Key="OnPrimaryContainerColor">#EBE4FF</Color>

    <Color x:Key="SecondaryColor">#615594</Color>
    <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
    <Color x:Key="SecondaryContainerColor">#C5B8FE</Color>
    <Color x:Key="OnSecondaryContainerColor">#514683</Color>

    <!-- Warm amber accent, auto-derived as the complement to the violet seed.
         Use for discount badges, low-stock flags, "card payment" state, etc. -->
    <Color x:Key="TertiaryColor">#7C3F00</Color>
    <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
    <Color x:Key="TertiaryContainerColor">#A05300</Color>
    <Color x:Key="OnTertiaryContainerColor">#FFE1CE</Color>

    <Color x:Key="ErrorColor">#BA1A1A</Color>
    <Color x:Key="OnErrorColor">#FFFFFF</Color>
    <Color x:Key="ErrorContainerColor">#FFDAD6</Color>
    <Color x:Key="OnErrorContainerColor">#93000A</Color>

    <Color x:Key="BackgroundColor">#FDF8FF</Color>
    <Color x:Key="OnBackgroundColor">#1C1A23</Color>

    <Color x:Key="SurfaceColor">#FDF8FF</Color>
    <Color x:Key="OnSurfaceColor">#1C1A23</Color>
    <Color x:Key="SurfaceVariantColor">#E6DFF3</Color>
    <Color x:Key="OnSurfaceVariantColor">#484554</Color>

    <Color x:Key="SurfaceContainerLowestColor">#FFFFFF</Color>
    <Color x:Key="SurfaceContainerLowColor">#F7F1FE</Color>
    <Color x:Key="SurfaceContainerColor">#F1ECF8</Color>
    <Color x:Key="SurfaceContainerHighColor">#ECE6F3</Color>
    <Color x:Key="SurfaceContainerHighestColor">#E6E0ED</Color>

    <Color x:Key="OutlineColor">#797586</Color>
    <Color x:Key="OutlineVariantColor">#CAC4D7</Color>

    <Color x:Key="InverseSurfaceColor">#312F39</Color>
    <Color x:Key="InverseOnSurfaceColor">#F4EEFB</Color>
    <Color x:Key="InversePrimaryColor">#CBBEFF</Color>

    <Color x:Key="ScrimColor">#000000</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Brushes — what XAML actually binds to -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainerColor}" />

    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="OnSecondaryBrush" Color="{StaticResource OnSecondaryColor}" />
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainerColor}" />
    <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="{StaticResource OnSecondaryContainerColor}" />

    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource TertiaryColor}" />
    <SolidColorBrush x:Key="OnTertiaryBrush" Color="{StaticResource OnTertiaryColor}" />
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="{StaticResource TertiaryContainerColor}" />
    <SolidColorBrush x:Key="OnTertiaryContainerBrush" Color="{StaticResource OnTertiaryContainerColor}" />

    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="OnErrorBrush" Color="{StaticResource OnErrorColor}" />
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainerColor}" />
    <SolidColorBrush x:Key="OnErrorContainerBrush" Color="{StaticResource OnErrorContainerColor}" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="OnBackgroundBrush" Color="{StaticResource OnBackgroundColor}" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}" />
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource OnSurfaceVariantColor}" />

    <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="{StaticResource SurfaceContainerLowestColor}" />
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="{StaticResource SurfaceContainerLowColor}" />
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainerColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHighColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighestColor}" />

    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}" />
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource OutlineVariantColor}" />

    <SolidColorBrush x:Key="InverseSurfaceBrush" Color="{StaticResource InverseSurfaceColor}" />
    <SolidColorBrush x:Key="InverseOnSurfaceBrush" Color="{StaticResource InverseOnSurfaceColor}" />
    <SolidColorBrush x:Key="InversePrimaryBrush" Color="{StaticResource InversePrimaryColor}" />

    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />
    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource ShadowColor}" />

</ResourceDictionary>
