<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Category filter chip (Checkout's horizontal category row). Same
        selected/hover pattern as NavListBoxItemStyle in NavStyles.xaml, but
        pill-shaped and horizontal instead of a full-width sidebar row.
        Uses TextBlock.Foreground (an inherited property) rather than a
        local Foreground on the DataTemplate's TextBlock, so the IsSelected
        trigger can actually override it — a local value on the TextBlock
        itself would win over anything set here.
    -->
    <Style x:Key="CategoryChipListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            CornerRadius="20"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource SurfaceContainerBrush}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Base template for Checkout's Cash/Card selector buttons. Unlike
        ThemeToggleButtonStyle (NavStyles.xaml) — which hardcodes its
        Background because it never needs to change at runtime — this one
        uses TemplateBinding Background so the Style-level DataTrigger below
        can actually repaint it: a hardcoded Background here would silently
        ignore any Setter the Style applies, same trap Mahmoud already found
        and fixed once for the plain WPF Button template.
    -->
    <ControlTemplate x:Key="SelectableButtonTemplate" TargetType="Button">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                CornerRadius="10"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="CashToggleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Template" Value="{StaticResource SelectableButtonTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCashSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CardToggleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Template" Value="{StaticResource SelectableButtonTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCardSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
