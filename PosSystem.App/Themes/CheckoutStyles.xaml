<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Category filter chip (Checkout's horizontal category row). Same
        selected/hover pattern as NavListBoxItemStyle in NavStyles.xaml, but
        pill-shaped and horizontal instead of a full-width sidebar row.
        Uses TextBlock.Foreground (an inherited property) rather than a
        local Foreground on the DataTemplate's TextBlock, so the IsSelected
        trigger can actually override it — a local value on the TextBlock
        itself would win over anything set here.
    -->
    <Style x:Key="CategoryChipListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            CornerRadius="20"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource SurfaceContainerBrush}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Base template for Checkout's Cash/Card selector buttons. Unlike
        ThemeToggleButtonStyle (NavStyles.xaml) — which hardcodes its
        Background because it never needs to change at runtime — this one
        uses TemplateBinding Background so the Style-level DataTrigger below
        can actually repaint it: a hardcoded Background here would silently
        ignore any Setter the Style applies, same trap Mahmoud already found
        and fixed once for the plain WPF Button template.
    -->
    <ControlTemplate x:Key="SelectableButtonTemplate" TargetType="Button">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                CornerRadius="10"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="CashToggleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Template" Value="{StaticResource SelectableButtonTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCashSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CardToggleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Template" Value="{StaticResource SelectableButtonTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCardSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Pay Later toggle — Phase 5. Uses TertiaryBrush rather than
        PrimaryBrush like Cash/Card's selected state: Colors.Light.xaml
        documents Tertiary as the accent for "discount badges, low-stock
        flags" — states that want a second color separate from the app's
        main action color — and "this sale is going on a tab" fits that
        same category. SelectableButtonTemplate (above) has no disabled
        visual of its own, so the IsEnabled=False trigger here is what
        actually dims the button while no customer is picked.
    -->
    <Style x:Key="PayLaterToggleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Template" Value="{StaticResource SelectableButtonTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPayLaterSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource TertiaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnTertiaryBrush}" />
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Dashboard quick-range buttons (Dashboard-Parity-Plan.md Stage 2).
        Four dedicated styles rather than one generic Tag-bound style — WPF
        trigger matching against a boxed bool via Tag is a known-unreliable
        pattern; binding each DataTrigger directly to its own named bool
        property (same as CashToggleButtonStyle/CardToggleButtonStyle above)
        is more verbose but proven to actually work in this codebase.
    -->
    <Style x:Key="RangeTodayButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Template" Value="{StaticResource SelectableButtonTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRangeTodaySelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RangeWeekButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Template" Value="{StaticResource SelectableButtonTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRangeWeekSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RangeMonthButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Template" Value="{StaticResource SelectableButtonTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRangeMonthSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RangeLast30ButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Template" Value="{StaticResource SelectableButtonTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRangeLast30Selected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- All Time — added 2026-08-24. Same DataTrigger pattern as the four
         above, bound to DashboardViewModel.IsRangeAllTimeSelected. Range
         start is computed from the earliest real sale on record
         (DashboardViewModel.GetEarliestDataDate), not a fixed lookback like
         the others. -->
    <Style x:Key="RangeAllTimeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Template" Value="{StaticResource SelectableButtonTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRangeAllTimeSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
