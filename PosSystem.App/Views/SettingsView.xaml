<UserControl x:Class="PosSystem.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PosSystem.App.ViewModels"
             xmlns:loc="clr-namespace:PosSystem.App.Localization"
             xmlns:theming="clr-namespace:PosSystem.App.Theming"
             FlowDirection="{DynamicResource AppFlowDirection}">

    <UserControl.DataContext>
        <vm:SettingsViewModel />
    </UserControl.DataContext>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" MaxWidth="520" Margin="0,32">
                <TextBlock Text="{DynamicResource SettingsHeading}"
                           Style="{StaticResource DisplayLarge}"
                           Foreground="{DynamicResource OnSurfaceBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource SettingsDescription}"
                           Style="{StaticResource BodyLarge}"
                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,8,0,24" />

                <!-- Appearance (rewritten 2026-08-26 — replaces the single
                     bare "Toggle Language" button this screen used to have,
                     plus surfaces Theme here too instead of leaving it only
                     reachable from the sidebar footer). Both pickers apply
                     instantly on click — no Save step, nothing to validate
                     — and show which option is actually active via
                     SettingsViewModel's IsEnglishSelected/IsArabicSelected/
                     IsLightThemeSelected/IsDarkThemeSelected, kept in sync
                     even if Theme changes from the sidebar's own toggle
                     button instead of from here. -->
                <Border Background="{DynamicResource SurfaceContainerLowBrush}"
                        CornerRadius="16"
                        Padding="24"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsAppearanceTitle}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   Margin="0,0,0,16" />

                        <TextBlock Text="{DynamicResource SettingsLanguageLabel}"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Language names shown in themselves ("English",
                                 "العربية") regardless of which UI language is
                                 currently active — the usual convention for a
                                 language picker — so both values are the same
                                 literal text in both Strings.*.xaml files
                                 rather than actually translated. -->
                            <Button Grid.Column="0"
                                    Content="{DynamicResource SettingsLanguageEnglish}"
                                    Command="{Binding SetLanguageCommand}"
                                    CommandParameter="{x:Static loc:AppLanguage.English}"
                                    Padding="0,10"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource LanguageEnglishButtonStyle}" />
                            <Button Grid.Column="2"
                                    Content="{DynamicResource SettingsLanguageArabic}"
                                    Command="{Binding SetLanguageCommand}"
                                    CommandParameter="{x:Static loc:AppLanguage.Arabic}"
                                    Padding="0,10"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource LanguageArabicButtonStyle}" />
                        </Grid>

                        <TextBlock Text="{DynamicResource SettingsThemeLabel}"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="{DynamicResource SettingsThemeLight}"
                                    Command="{Binding SetThemeCommand}"
                                    CommandParameter="{x:Static theming:AppTheme.Light}"
                                    Padding="0,10"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource ThemeLightButtonStyle}" />
                            <Button Grid.Column="2"
                                    Content="{DynamicResource SettingsThemeDark}"
                                    Command="{Binding SetThemeCommand}"
                                    CommandParameter="{x:Static theming:AppTheme.Dark}"
                                    Padding="0,10"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource ThemeDarkButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Preferences (added 2026-08-26, unchanged from before this
                     rewrite) — same card shape every other screen's form
                     already uses, and the one section on this screen that
                     still needs an explicit Save step (there's real
                     validation on both fields) — see SettingsViewModel's
                     class doc comment. -->
                <Border Background="{DynamicResource SurfaceContainerLowBrush}"
                        CornerRadius="16"
                        Padding="24"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsPreferencesTitle}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   Margin="0,0,0,16" />

                        <!-- Locked state (admin gate added per Mahmoud's
                             request), same inline-unlock-box pattern as
                             the Export section below; shares AdminSession,
                             so unlocking here or on any other gated section
                             unlocks this one too. -->
                        <StackPanel Visibility="{Binding IsPreferencesLocked, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource SettingsPreferencesAdminRequired}"
                                       Style="{StaticResource BodyLarge}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox Grid.Column="0"
                                             x:Name="PreferencesUnlockPasswordBox"
                                             Style="{StaticResource ThemedPasswordBoxStyle}"
                                             PasswordChanged="PreferencesUnlockPasswordBox_PasswordChanged" />
                                <Button Grid.Column="2"
                                        Content="{DynamicResource DashboardUnlockButton}"
                                        Command="{Binding PreferencesUnlockCommand}"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Foreground="{DynamicResource OnPrimaryBrush}"
                                        Template="{StaticResource SelectableButtonTemplate}"
                                        Padding="16,8" />
                            </Grid>
                            <TextBlock Text="{Binding PreferencesUnlockError}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- Unlocked state -->
                        <StackPanel Visibility="{Binding IsPreferencesUnlocked, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource SettingsTaxRateLabel}"
                                       Style="{StaticResource LabelSmall}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       Margin="0,0,0,4" />
                            <TextBox Text="{Binding TaxRatePercentInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ThemedTextBoxStyle}"
                                     Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource SettingsTaxRateHint}"
                                       Style="{StaticResource LabelSmall}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16" />

                            <TextBlock Text="{DynamicResource SettingsLowStockThresholdLabel}"
                                       Style="{StaticResource LabelSmall}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       Margin="0,0,0,4" />
                            <TextBox Text="{Binding LowStockThresholdInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ThemedTextBoxStyle}"
                                     Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource SettingsLowStockThresholdHint}"
                                       Style="{StaticResource LabelSmall}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,20" />

                            <Button Content="{DynamicResource SettingsSaveButton}"
                                    Command="{Binding SaveCommand}"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Foreground="{DynamicResource OnPrimaryBrush}"
                                    Template="{StaticResource SelectableButtonTemplate}"
                                    Padding="0,12"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Data & Backup (new, 2026-08-26) — see SettingsViewModel's
                     class doc comment for why this is backup-only, no
                     restore. Path/size are read-only display, deliberately
                     not editable fields. -->
                <Border Background="{DynamicResource SurfaceContainerLowBrush}"
                        CornerRadius="16"
                        Padding="24"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsDataBackupTitle}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{DynamicResource SettingsDatabaseLocationLabel}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DatabasePathDisplay}"
                                       Foreground="{DynamicResource OnSurfaceBrush}"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{DynamicResource SettingsDatabaseSizeLabel}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DatabaseSizeDisplay}"
                                       Foreground="{DynamicResource OnSurfaceBrush}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="{DynamicResource SettingsBackupNowButton}"
                                    Command="{Binding BackupNowCommand}"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Foreground="{DynamicResource OnPrimaryBrush}"
                                    Template="{StaticResource SelectableButtonTemplate}"
                                    Padding="0,12"
                                    HorizontalContentAlignment="Center" />
                            <Button Grid.Column="2"
                                    Content="{DynamicResource SettingsOpenBackupsFolderButton}"
                                    Command="{Binding OpenBackupsFolderCommand}"
                                    Background="{DynamicResource SurfaceContainerHighBrush}"
                                    Foreground="{DynamicResource OnSurfaceBrush}"
                                    Template="{StaticResource SelectableButtonTemplate}"
                                    Padding="0,12"
                                    HorizontalContentAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Contact Support card moved to Help (2026-08-28, per
                     Mahmoud's request) — see HelpView.xaml. -->

                <!-- Export (Phase 11 #3, 2026-08-28) — see SettingsViewModel's
                     class doc comment for why this is gated (revenue-
                     sensitive) and follows Inventory's inline-unlock-box
                     pattern rather than locking the whole Settings screen. -->
                <Border Background="{DynamicResource SurfaceContainerLowBrush}"
                        CornerRadius="16"
                        Padding="24"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ExportSectionTitle}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{DynamicResource ExportSectionSubtitle}"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16" />

                        <!-- Locked state -->
                        <StackPanel Visibility="{Binding IsExportLocked, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource ExportAdminRequired}"
                                       Style="{StaticResource BodyLarge}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox Grid.Column="0"
                                             x:Name="ExportUnlockPasswordBox"
                                             Style="{StaticResource ThemedPasswordBoxStyle}"
                                             PasswordChanged="ExportUnlockPasswordBox_PasswordChanged" />
                                <Button Grid.Column="2"
                                        Content="{DynamicResource DashboardUnlockButton}"
                                        Command="{Binding ExportUnlockCommand}"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Foreground="{DynamicResource OnPrimaryBrush}"
                                        Template="{StaticResource SelectableButtonTemplate}"
                                        Padding="16,8" />
                            </Grid>
                            <TextBlock Text="{Binding ExportUnlockError}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- Unlocked state -->
                        <StackPanel Visibility="{Binding IsExportUnlocked, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource ExportRangeLabel}"
                                       Style="{StaticResource LabelSmall}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       Margin="0,0,0,6" />
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Button Content="{DynamicResource ExportRangeLast7}"
                                        Command="{Binding SetExportQuickRangeCommand}"
                                        CommandParameter="{x:Static vm:ExportQuickRange.Last7Days}"
                                        Style="{StaticResource ExportRangeLast7ButtonStyle}"
                                        Padding="14,8" Margin="0,0,8,8" />
                                <Button Content="{DynamicResource ExportRangeLast30}"
                                        Command="{Binding SetExportQuickRangeCommand}"
                                        CommandParameter="{x:Static vm:ExportQuickRange.Last30Days}"
                                        Style="{StaticResource ExportRangeLast30ButtonStyle}"
                                        Padding="14,8" Margin="0,0,8,8" />
                                <Button Content="{DynamicResource ExportRangeThisWeek}"
                                        Command="{Binding SetExportQuickRangeCommand}"
                                        CommandParameter="{x:Static vm:ExportQuickRange.ThisWeek}"
                                        Style="{StaticResource ExportRangeThisWeekButtonStyle}"
                                        Padding="14,8" Margin="0,0,8,8" />
                                <Button Content="{DynamicResource ExportRangeThisMonth}"
                                        Command="{Binding SetExportQuickRangeCommand}"
                                        CommandParameter="{x:Static vm:ExportQuickRange.ThisMonth}"
                                        Style="{StaticResource ExportRangeThisMonthButtonStyle}"
                                        Padding="14,8" Margin="0,0,8,8" />
                                <Button Content="{DynamicResource ExportRangeThisYear}"
                                        Command="{Binding SetExportQuickRangeCommand}"
                                        CommandParameter="{x:Static vm:ExportQuickRange.ThisYear}"
                                        Style="{StaticResource ExportRangeThisYearButtonStyle}"
                                        Padding="14,8" Margin="0,0,0,8" />
                            </WrapPanel>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource DashboardFilterFromLabel}"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                               Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding ExportStartDate, Mode=TwoWay}"
                                                Style="{StaticResource ThemedDatePickerStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource DashboardFilterToLabel}"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                               Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding ExportEndDate, Mode=TwoWay}"
                                                Style="{StaticResource ThemedDatePickerStyle}" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="{DynamicResource ExportToExcelButton}"
                                        Command="{Binding ExportToExcelCommand}"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Foreground="{DynamicResource OnPrimaryBrush}"
                                        Template="{StaticResource SelectableButtonTemplate}"
                                        Padding="0,12"
                                        HorizontalContentAlignment="Center" />
                                <Button Grid.Column="2"
                                        Content="{DynamicResource ExportOpenFolderButton}"
                                        Command="{Binding OpenExportsFolderCommand}"
                                        Background="{DynamicResource SurfaceContainerHighBrush}"
                                        Foreground="{DynamicResource OnSurfaceBrush}"
                                        Template="{StaticResource SelectableButtonTemplate}"
                                        Padding="0,12"
                                        HorizontalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Admin password (#7, 2026-08-27) — gates Dashboard
                     access (revenue is business-sensitive per Mahmoud). See
                     SettingsViewModel's doc comment on the new fields for
                     why they're never pre-filled, and AppSettings'
                     SetAdminPassword doc comment for the blank+blank+Save
                     clear-password recovery path. -->
                <Border Background="{DynamicResource SurfaceContainerLowBrush}"
                        CornerRadius="16"
                        Padding="24"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsAdminPasswordSectionTitle}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{DynamicResource SettingsAdminPasswordDescription}"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <!-- Locked state (admin gate added per Mahmoud's
                             request), changing the admin password now
                             requires the CURRENT one first, same inline-
                             unlock-box pattern as Export/Preferences.
                             Shares AdminSession, so unlocking here or on
                             any other gated section unlocks this one too. -->
                        <StackPanel Visibility="{Binding IsAdminPasswordLocked, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource SettingsAdminPasswordUnlockRequired}"
                                       Style="{StaticResource BodyLarge}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox Grid.Column="0"
                                             x:Name="AdminPasswordUnlockPasswordBox"
                                             Style="{StaticResource ThemedPasswordBoxStyle}"
                                             PasswordChanged="AdminPasswordUnlockPasswordBox_PasswordChanged" />
                                <Button Grid.Column="2"
                                        Content="{DynamicResource DashboardUnlockButton}"
                                        Command="{Binding AdminPasswordUnlockCommand}"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Foreground="{DynamicResource OnPrimaryBrush}"
                                        Template="{StaticResource SelectableButtonTemplate}"
                                        Padding="16,8" />
                            </Grid>
                            <TextBlock Text="{Binding AdminPasswordUnlockError}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- Unlocked state -->
                        <StackPanel Visibility="{Binding IsAdminPasswordUnlocked, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border CornerRadius="8" Padding="10,6" Margin="0,0,0,16"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource SurfaceContainerHighBrush}">
                                <TextBlock Foreground="{DynamicResource OnSurfaceVariantBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
                                            <Setter Property="Text" Value="{DynamicResource SettingsAdminPasswordCurrentStatusNotSet}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAdminPassword}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource SettingsAdminPasswordCurrentStatusSet}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <TextBlock Text="{DynamicResource SettingsAdminPasswordNewLabel}"
                                       Style="{StaticResource LabelSmall}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       Margin="0,0,0,4" />
                            <PasswordBox x:Name="NewAdminPasswordBox"
                                         Style="{StaticResource ThemedPasswordBoxStyle}"
                                         PasswordChanged="NewAdminPasswordBox_PasswordChanged"
                                         Margin="0,0,0,12" />

                            <TextBlock Text="{DynamicResource SettingsAdminPasswordConfirmLabel}"
                                       Style="{StaticResource LabelSmall}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       Margin="0,0,0,4" />
                            <PasswordBox x:Name="ConfirmAdminPasswordBox"
                                         Style="{StaticResource ThemedPasswordBoxStyle}"
                                         PasswordChanged="ConfirmAdminPasswordBox_PasswordChanged"
                                         Margin="0,0,0,16" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="{DynamicResource SettingsAdminPasswordSaveButton}"
                                        Command="{Binding SaveAdminPasswordCommand}"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Foreground="{DynamicResource OnPrimaryBrush}"
                                        Template="{StaticResource SelectableButtonTemplate}"
                                        Padding="0,12"
                                        HorizontalContentAlignment="Center" />
                                <!-- Remove Password (added per Mahmoud's
                                     request) — explicit alternative to the
                                     blank+blank+Save removal path, only
                                     shown once a password actually exists
                                     to remove. See
                                     SettingsViewModel.RemoveAdminPasswordCommand's
                                     doc comment. -->
                                <Button Grid.Column="2"
                                        Content="{DynamicResource SettingsAdminPasswordRemoveButton}"
                                        Command="{Binding RemoveAdminPasswordCommand}"
                                        Background="{DynamicResource SurfaceContainerHighBrush}"
                                        Foreground="{DynamicResource ErrorBrush}"
                                        Template="{StaticResource SelectableButtonTemplate}"
                                        Padding="0,12"
                                        HorizontalContentAlignment="Center"
                                        Visibility="{Binding HasAdminPassword, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Shared status line — every command on this screen
                     (Save, Back Up Now, Open Backups Folder) writes into the
                     same SettingsViewModel.StatusMessage, same one-line-
                     under-the-form pattern every other screen's form uses,
                     just placed once at the bottom here since three
                     different sections can set it rather than only one. -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,16" />

                <!-- About (new, 2026-08-26) — static, read-only. -->
                <Border Background="{DynamicResource SurfaceContainerLowBrush}"
                        CornerRadius="16"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsAboutTitle}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{DynamicResource SettingsAboutDescription}"
                                   Style="{StaticResource BodyLarge}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding AppVersionDisplay}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

