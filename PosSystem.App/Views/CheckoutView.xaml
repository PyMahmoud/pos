<UserControl x:Class="PosSystem.App.Views.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PosSystem.App.ViewModels"
             FlowDirection="{DynamicResource AppFlowDirection}">

    <UserControl.DataContext>
        <vm:CheckoutViewModel />
    </UserControl.DataContext>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Item browser -->
        <Grid Grid.Column="0" Margin="24,20,16,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{DynamicResource CheckoutHeading}"
                       Style="{StaticResource HeadlineMedium}"
                       Foreground="{DynamicResource OnSurfaceBrush}"
                       Margin="0,0,0,16" />

            <TextBox Grid.Row="1"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="12,10"
                     Margin="0,0,0,16"
                     Background="{DynamicResource SurfaceContainerBrush}"
                     Foreground="{DynamicResource OnSurfaceBrush}"
                     CaretBrush="{DynamicResource OnSurfaceBrush}"
                     BorderThickness="0" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Category chips -->
                    <ListBox ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,0,0,4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource CategoryChipListBoxItemStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Item grid -->
                    <ItemsControl ItemsSource="{Binding FilteredGoods}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="184" Height="128" Margin="0,0,12,12"
                                        CornerRadius="14"
                                        Background="{DynamicResource SurfaceContainerBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Quantity, Converter={StaticResource GreaterThanZeroConverter}}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0">
                                            <TextBlock Text="{Binding Category}"
                                                       Style="{StaticResource LabelSmall}"
                                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource TitleMedium}"
                                                       Foreground="{DynamicResource OnSurfaceBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Price, StringFormat={}{0:0.00}}"
                                                       Style="{StaticResource TitleMedium}"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Content="+"
                                                    FontWeight="Bold"
                                                    Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ThemeToggleButtonStyle}"
                                                    Width="32" Height="32" Padding="0"
                                                    IsEnabled="{Binding Quantity, Converter={StaticResource GreaterThanZeroConverter}}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Cart -->
        <Border Grid.Column="1"
                Background="{DynamicResource SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource OutlineVariantBrush}"
                BorderThickness="1,0,0,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{DynamicResource CheckoutCartTitle}"
                           Style="{StaticResource TitleMedium}"
                           Foreground="{DynamicResource OnSurfaceBrush}"
                           Margin="0,0,0,12" />

                <Grid Grid.Row="1">
                    <TextBlock Text="{DynamicResource CheckoutCartEmpty}"
                               Style="{StaticResource BodyLarge}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               Visibility="{Binding CartLines.Count, Converter={StaticResource CountToVisibilityConverter}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CartLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceContainerBrush}"
                                            CornerRadius="12"
                                            Padding="12"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           Style="{StaticResource BodyLarge}"
                                                           Foreground="{DynamicResource OnSurfaceBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding LineTotal, StringFormat={}{0:0.00}}"
                                                           Style="{StaticResource BodyLarge}"
                                                           Foreground="{DynamicResource OnSurfaceBrush}"
                                                           Margin="8,0,0,0" />
                                            </Grid>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="−"
                                                        Command="{Binding DataContext.DecrementLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="28" Height="28" Padding="0"
                                                        Style="{StaticResource ThemeToggleButtonStyle}" />
                                                <TextBlock Text="{Binding Quantity, StringFormat={}{0:0.##}}"
                                                           Foreground="{DynamicResource OnSurfaceBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0" />
                                                <Button Content="+"
                                                        Command="{Binding DataContext.IncrementLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="28" Height="28" Padding="0"
                                                        Style="{StaticResource ThemeToggleButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">

                    <!-- Customer link — Phase 5. Walk-in (the default, first
                         entry) keeps every existing behavior unchanged;
                         picking a real customer here is what unlocks Pay
                         Later below. -->
                    <TextBlock Text="{DynamicResource CheckoutCustomerLabel}"
                               Style="{StaticResource LabelSmall}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource CheckoutTotal}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat={}{0:0.00}}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="{DynamicResource CheckoutCash}"
                                Command="{Binding SetPaymentMethodCommand}"
                                CommandParameter="{x:Static vm:PaymentMethod.Cash}"
                                Margin="0,0,4,0" Padding="0,10"
                                Style="{StaticResource CashToggleButtonStyle}" />
                        <Button Grid.Column="1"
                                Content="{DynamicResource CheckoutCard}"
                                Command="{Binding SetPaymentMethodCommand}"
                                CommandParameter="{x:Static vm:PaymentMethod.Card}"
                                Margin="4,0,4,0" Padding="0,10"
                                Style="{StaticResource CardToggleButtonStyle}" />
                        <Button Grid.Column="2"
                                Content="{DynamicResource CheckoutPayLater}"
                                Command="{Binding SetPaymentMethodCommand}"
                                CommandParameter="{x:Static vm:PaymentMethod.PayLater}"
                                IsEnabled="{Binding CanPayLater}"
                                Margin="4,0,0,0" Padding="0,10"
                                Style="{StaticResource PayLaterToggleButtonStyle}" />
                    </Grid>

                    <Button Content="{DynamicResource CheckoutCompleteSale}"
                            Command="{Binding CompleteSaleCommand}"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="{DynamicResource OnPrimaryBrush}"
                            Template="{StaticResource SelectableButtonTemplate}"
                            Padding="0,14"
                            HorizontalContentAlignment="Center" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
