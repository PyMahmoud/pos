<UserControl x:Class="PosSystem.App.Views.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PosSystem.App.ViewModels"
             FlowDirection="{DynamicResource AppFlowDirection}">

    <UserControl.DataContext>
        <vm:CheckoutViewModel />
    </UserControl.DataContext>

    <!-- Panel positions are pinned LeftToRight regardless of language.
         Item browser always on the left, cart always on the right (per
         explicit request: RTL auto-mirroring was flipping this whole
         two-column layout, which isn't wanted here). Each panel below
         re-binds its own FlowDirection to AppFlowDirection so the CONTENT
         inside (Arabic text alignment, chip wrap order, etc.) still adapts
         correctly per language. Only the outer left/right placement of
         the two panels is fixed. -->
    <Grid Background="{DynamicResource BackgroundBrush}" FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Item browser -->
        <Grid Grid.Column="0" Margin="24,20,16,20" FlowDirection="{DynamicResource AppFlowDirection}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{DynamicResource CheckoutHeading}"
                       Style="{StaticResource HeadlineMedium}"
                       Foreground="{DynamicResource OnSurfaceBrush}"
                       Margin="0,0,0,16" />

            <TextBox Grid.Row="1"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="12,10"
                     Margin="0,0,0,16"
                     Background="{DynamicResource SurfaceContainerBrush}"
                     Foreground="{DynamicResource OnSurfaceBrush}"
                     CaretBrush="{DynamicResource OnSurfaceBrush}"
                     BorderThickness="0" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Category filter — wide dropdown (2026-08-26),
                         replacing the wrapped chip row: same ThemedComboBoxStyle
                         used by Inventory's Add Product category field, same
                         Categories/SelectedCategory binding as before (only the
                         control changed, not the ViewModel), DisplayMemberPath
                         instead of an ItemTemplate since a plain ComboBox needs
                         no chip-selection visuals. -->
                    <TextBlock Text="{DynamicResource DashboardCategoryFilterLabel}"
                               Style="{StaticResource LabelSmall}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding FilteredCategoryOptions}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              Text="{Binding CategorySearchText, UpdateSourceTrigger=PropertyChanged}"
                              IsDropDownOpen="{Binding IsCategoryDropDownOpen, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              Margin="0,0,0,4" />

                    <!-- Item grid -->
                    <ItemsControl ItemsSource="{Binding FilteredGoods}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="184" Height="128" Margin="0,0,12,12"
                                        CornerRadius="14"
                                        Background="{DynamicResource SurfaceContainerBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Quantity, Converter={StaticResource GreaterThanZeroConverter}}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0">
                                            <TextBlock Text="{Binding Category}"
                                                       Style="{StaticResource LabelSmall}"
                                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource TitleMedium}"
                                                       Foreground="{DynamicResource OnSurfaceBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Price, StringFormat={}{0:0.00}}"
                                                       Style="{StaticResource TitleMedium}"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Content="+"
                                                    FontWeight="Bold"
                                                    Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ThemeToggleButtonStyle}"
                                                    Width="32" Height="32" Padding="0"
                                                    IsEnabled="{Binding Quantity, Converter={StaticResource GreaterThanZeroConverter}}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Cart -->
        <Border Grid.Column="1"
                Background="{DynamicResource SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource OutlineVariantBrush}"
                BorderThickness="1,0,0,0"
                FlowDirection="{DynamicResource AppFlowDirection}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{DynamicResource CheckoutCartTitle}"
                           Style="{StaticResource TitleMedium}"
                           Foreground="{DynamicResource OnSurfaceBrush}"
                           Margin="0,0,0,12" />

                <Grid Grid.Row="1">
                    <TextBlock Text="{DynamicResource CheckoutCartEmpty}"
                               Style="{StaticResource BodyLarge}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               Visibility="{Binding CartLines.Count, Converter={StaticResource CountToVisibilityConverter}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CartLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceContainerBrush}"
                                            CornerRadius="12"
                                            Padding="12"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           Style="{StaticResource BodyLarge}"
                                                           Foreground="{DynamicResource OnSurfaceBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding LineTotal, StringFormat={}{0:0.00}}"
                                                           Style="{StaticResource BodyLarge}"
                                                           Foreground="{DynamicResource OnSurfaceBrush}"
                                                           Margin="8,0,0,0" />
                                            </Grid>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="−"
                                                        Command="{Binding DataContext.DecrementLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="28" Height="28" Padding="0"
                                                        Style="{StaticResource ThemeToggleButtonStyle}" />
                                                <TextBlock Text="{Binding Quantity, StringFormat={}{0:0.##}}"
                                                           Foreground="{DynamicResource OnSurfaceBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0" />
                                                <Button Content="+"
                                                        Command="{Binding DataContext.IncrementLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="28" Height="28" Padding="0"
                                                        Style="{StaticResource ThemeToggleButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">

                    <!-- Bills browser entry point (#6, 2026-08-27/28) —
                         above the customer picker per Mahmoud's explicit
                         placement request. Opens BillsBrowserViewModel as a
                         full-screen overlay (see the Grid at the bottom of
                         this file) rather than trying to fit a bill list
                         into this 360px cart panel. -->
                    <Button Content="{DynamicResource CheckoutBillsButton}"
                            Command="{Binding OpenBillsCommand}"
                            Background="{DynamicResource SurfaceContainerHighBrush}"
                            Foreground="{DynamicResource OnSurfaceBrush}"
                            Template="{StaticResource SelectableButtonTemplate}"
                            Padding="0,10"
                            HorizontalContentAlignment="Center"
                            Margin="0,0,0,12" />

                    <!-- Customer link — Phase 5. Walk-in (the default, first
                         entry) keeps every existing behavior unchanged;
                         picking a real customer here is what unlocks Pay
                         Later below. -->
                    <TextBlock Text="{DynamicResource CheckoutCustomerLabel}"
                               Style="{StaticResource LabelSmall}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource CheckoutSubtotal}"
                                   Style="{StaticResource BodyLarge}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat={}{0:0.00}}"
                                   Style="{StaticResource BodyLarge}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                    </Grid>

                    <!-- Discount (2026-09-01) — editable percentage,
                         pre-filled from the linked customer's standing
                         default the moment they're picked (see
                         CheckoutViewModel.SelectedCustomer's setter) and
                         freely overridable for this one bill. Gated behind
                         AppSettings.GateDiscountEnabled, same inline-
                         unlock-box pattern as every other admin-gated
                         section, just compact enough to fit this 360px
                         cart panel. -->
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding IsDiscountUnlocked, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource CheckoutDiscountLabel}"
                                   Style="{StaticResource BodyLarge}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding DiscountPercentInput, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ThemedTextBoxStyle}"
                                 HorizontalContentAlignment="Right" />
                    </Grid>

                    <StackPanel Margin="0,0,0,8"
                                Visibility="{Binding IsDiscountLocked, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox Grid.Column="0"
                                         x:Name="DiscountUnlockPasswordBox"
                                         Style="{StaticResource ThemedPasswordBoxStyle}"
                                         PasswordChanged="DiscountUnlockPasswordBox_PasswordChanged" />
                            <Button Grid.Column="2"
                                    Content="{DynamicResource DashboardUnlockButton}"
                                    Command="{Binding DiscountUnlockCommand}"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Foreground="{DynamicResource OnPrimaryBrush}"
                                    Template="{StaticResource SelectableButtonTemplate}"
                                    Padding="12,8" />
                        </Grid>
                        <TextBlock Text="{Binding DiscountUnlockError}"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Discount amount line, only shown once it's actually
                         nonzero — a shop that never sets a discount sees no
                         change from before this feature. -->
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding DiscountAmount, Converter={StaticResource PositiveNumberToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource CheckoutDiscountAmountLabel}"
                                   Style="{StaticResource BodyLarge}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding DiscountAmount, StringFormat={}-{0:0.00}}"
                                   Style="{StaticResource BodyLarge}"
                                   Foreground="{DynamicResource TertiaryBrush}" />
                    </Grid>

                    <!-- Tax line (2026-08-26), only shown when there's
                         actually a rate set (AppSettings.TaxRatePercent via
                         CheckoutViewModel.TaxAmount), so a shop that never
                         touches the new Settings field sees the exact same
                         two-line Total this cart always had, not a
                         permanent "Tax: 0.00" row nobody asked to see. -->
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding TaxAmount, Converter={StaticResource PositiveNumberToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource CheckoutTax}"
                                   Style="{StaticResource BodyLarge}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding TaxAmount, StringFormat={}{0:0.00}}"
                                   Style="{StaticResource BodyLarge}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource CheckoutTotal}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat={}{0:0.00}}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="{DynamicResource CheckoutCash}"
                                Command="{Binding SetPaymentMethodCommand}"
                                CommandParameter="{x:Static vm:PaymentMethod.Cash}"
                                Margin="0,0,4,0" Padding="0,10"
                                Style="{StaticResource CashToggleButtonStyle}" />
                        <Button Grid.Column="1"
                                Content="{DynamicResource CheckoutCard}"
                                Command="{Binding SetPaymentMethodCommand}"
                                CommandParameter="{x:Static vm:PaymentMethod.Card}"
                                Margin="4,0,4,0" Padding="0,10"
                                Style="{StaticResource CardToggleButtonStyle}" />
                        <Button Grid.Column="2"
                                Content="{DynamicResource CheckoutPayLater}"
                                Command="{Binding SetPaymentMethodCommand}"
                                CommandParameter="{x:Static vm:PaymentMethod.PayLater}"
                                IsEnabled="{Binding CanPayLater}"
                                Margin="4,0,0,0" Padding="0,10"
                                Style="{StaticResource PayLaterToggleButtonStyle}" />
                    </Grid>

                    <Button Content="{DynamicResource CheckoutCompleteSale}"
                            Command="{Binding CompleteSaleCommand}"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="{DynamicResource OnPrimaryBrush}"
                            Template="{StaticResource SelectableButtonTemplate}"
                            Padding="0,14"
                            HorizontalContentAlignment="Center" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Bills browser overlay (#6, 2026-08-27/28) =================
             Covers the whole screen (both columns) while a bill browser is
             open — same "always Visible, collapse on {x:Null}" trick
             CustomersView's detail panel uses, here driven by whether
             CheckoutViewModel.SelectedBillsBrowser is null. DataContext is
             set to that BillsBrowserViewModel once, at the Grid level, so
             every binding below is against it, not CheckoutViewModel. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              DataContext="{Binding SelectedBillsBrowser}"
              Panel.ZIndex="20"
              FlowDirection="{DynamicResource AppFlowDirection}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource BackgroundBrush}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header: title + close -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource BillsBrowserTitle}"
                                   Style="{StaticResource HeadlineMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <Button Grid.Column="1"
                                Content="{DynamicResource BillsBrowserCloseButton}"
                                Command="{Binding CloseCommand}"
                                Background="{DynamicResource SurfaceContainerHighBrush}"
                                Foreground="{DynamicResource OnSurfaceBrush}"
                                Template="{StaticResource SelectableButtonTemplate}"
                                Padding="14,8" />
                    </Grid>

                    <!-- Admin-locked notice — as of 2026-08-28, viewing the
                         bill list/detail itself is gated too (see the
                         wrapper Grid below), not just Remove/Delete
                         actions. This box is what lets someone unlock from
                         right here without leaving the Bills screen. -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceContainerLowBrush}"
                            CornerRadius="14" Padding="16" Margin="0,0,0,16"
                            Visibility="{Binding IsAdminLocked, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource BillsAdminLockedTitle}"
                                       Style="{StaticResource TitleMedium}"
                                       Foreground="{DynamicResource OnSurfaceBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource BillsAdminLockedSubtitle}"
                                       Style="{StaticResource BodyLarge}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox Grid.Column="0"
                                             Style="{StaticResource ThemedPasswordBoxStyle}"
                                             PasswordChanged="BillsAdminUnlockPasswordBox_PasswordChanged" />
                                <Button Grid.Column="2"
                                        Content="{DynamicResource DashboardUnlockButton}"
                                        Command="{Binding AdminUnlockCommand}"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Foreground="{DynamicResource OnPrimaryBrush}"
                                        Template="{StaticResource SelectableButtonTemplate}"
                                        Padding="16,8" />
                            </Grid>
                            <TextBlock Text="{Binding AdminUnlockError}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Browsing area (list + detail) — gated behind admin
                         unlock (2026-08-28, per explicit request): the whole
                         Bills screen, not just the delete actions, now
                         requires the admin password before any bill data is
                         shown at all. Both inner Grids below keep their own
                         SelectedBill-based list/detail toggle unchanged;
                         this wrapper just adds the outer lock. -->
                    <Grid Grid.Row="2" Visibility="{Binding IsAdminUnlocked, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- ============ BILL LIST ============ -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedBill}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16" MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock Text="{DynamicResource BillsBrowserSearchLabel}"
                                       Style="{StaticResource LabelSmall}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       Margin="0,0,0,4" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ThemedTextBoxStyle}" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <TextBlock Text="{DynamicResource BillsBrowserNoResults}"
                                       Style="{StaticResource BodyLarge}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"
                                       Visibility="{Binding Bills.Count, Converter={StaticResource CountToVisibilityConverter}}" />

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Bills}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="260" Margin="0,0,16,16"
                                                    CornerRadius="14" Padding="18"
                                                    Background="{DynamicResource SurfaceContainerBrush}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayNumber, StringFormat={}Bill #{0}}"
                                                               Style="{StaticResource TitleMedium}"
                                                               Foreground="{DynamicResource OnSurfaceBrush}" />
                                                    <!-- "Edited" tag (2026-08-28, receipt revisioning) —
                                                         shown on a superseded original/earlier revision so
                                                         the list makes clear #210 and #210-e1 are the SAME
                                                         receipt at two points in time, not two unrelated
                                                         sales that happen to share a number. -->
                                                    <TextBlock Text="{DynamicResource BillsBrowserSupersededTag}"
                                                               Style="{StaticResource LabelSmall}"
                                                               Foreground="{DynamicResource TertiaryBrush}"
                                                               Visibility="{Binding IsCurrent, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                               Style="{StaticResource LabelSmall}"
                                                               Margin="0,2,0,0">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0}   {1}">
                                                                <Binding Path="Datex" />
                                                                <Binding Path="Time" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                               Margin="0,2,0,0"
                                                               TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
                                                                <Setter Property="Text" Value="{Binding Ownername}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Ownername}" Value="">
                                                                        <Setter Property="Text" Value="{DynamicResource BillsBrowserWalkInLabel}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Billcost, StringFormat={}{0:0.00}}"
                                                               Style="{StaticResource TitleMedium}"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               Margin="0,10,0,0" />
                                                    <Button Content="{DynamicResource BillsBrowserViewButton}"
                                                            Command="{Binding DataContext.ViewBillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="{DynamicResource SurfaceContainerHighBrush}"
                                                            Foreground="{DynamicResource OnSurfaceBrush}"
                                                            Template="{StaticResource SelectableButtonTemplate}"
                                                            Padding="0,10"
                                                            Margin="0,10,0,0"
                                                            HorizontalContentAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ============ BILL DETAIL ============ -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedBill}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding SelectedBill.DisplayNumber, StringFormat={}Bill #{0}}"
                                                   Style="{StaticResource HeadlineMedium}"
                                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                                        <TextBlock Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                   Style="{StaticResource BodyLarge}"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}   {1}">
                                                    <Binding Path="SelectedBill.Datex" />
                                                    <Binding Path="SelectedBill.Time" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{DynamicResource BillsDetailBackButton}"
                                            Command="{Binding BackToListCommand}"
                                            Background="{DynamicResource SurfaceContainerHighBrush}"
                                            Foreground="{DynamicResource OnSurfaceBrush}"
                                            Template="{StaticResource SelectableButtonTemplate}"
                                            Padding="14,10"
                                            VerticalAlignment="Top" />
                                </Grid>

                                <!-- Bill totals -->
                                <Border Background="{DynamicResource SurfaceContainerBrush}"
                                        CornerRadius="14" Padding="18" Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource CheckoutTax}" Style="{StaticResource BodyLarge}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedBill.Tax, StringFormat={}{0:0.00}}" Style="{StaticResource BodyLarge}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource CheckoutTotal}" Style="{StaticResource TitleMedium}" Foreground="{DynamicResource OnSurfaceBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedBill.Billcost, StringFormat={}{0:0.00}}" Style="{StaticResource TitleMedium}" Foreground="{DynamicResource PrimaryBrush}" />
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource CustomersBalancePaidUp}" Style="{StaticResource BodyLarge}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedBill.Paid, StringFormat={}{0:0.00}}" Style="{StaticResource BodyLarge}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource CustomersPaymentAmountLabel}" Style="{StaticResource BodyLarge}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedBill.Remain, StringFormat={}{0:0.00}}" Style="{StaticResource BodyLarge}" Foreground="{DynamicResource TertiaryBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Superseded-history banner (2026-08-28, receipt
                                     revisioning) — shown only when this bill is an
                                     older/original version that's since been returned-
                                     from (IsSelectedBillSuperseded). Return actions below
                                     (line +/-, Remove, whole-bill) are all hidden in this
                                     state via IsSelectedBillCurrent — history is frozen,
                                     read-only, exactly as it was actually sold. -->
                                <Border Background="{DynamicResource SurfaceContainerLowBrush}"
                                        CornerRadius="14" Padding="16" Margin="0,0,0,20"
                                        Visibility="{Binding IsSelectedBillSuperseded, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{DynamicResource BillsBrowserSupersededBanner}"
                                                   Style="{StaticResource BodyLarge}"
                                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Content="{DynamicResource BillsBrowserViewCurrentButton}"
                                                Command="{Binding ViewCurrentVersionCommand}"
                                                Background="{DynamicResource PrimaryBrush}"
                                                Foreground="{DynamicResource OnPrimaryBrush}"
                                                Template="{StaticResource SelectableButtonTemplate}"
                                                Padding="14,10"
                                                Margin="12,0,0,0" />
                                    </Grid>
                                </Border>

                                <!-- Line items -->
                                <TextBlock Text="{DynamicResource BillsDetailItemsTitle}"
                                           Style="{StaticResource TitleMedium}"
                                           Foreground="{DynamicResource OnSurfaceBrush}"
                                           Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding BillLines}" Margin="0,0,0,20">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceContainerBrush}"
                                                    CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="116" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                               Style="{StaticResource BodyLarge}"
                                                               Foreground="{DynamicResource OnSurfaceBrush}"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center" />

                                                    <!-- Line-level return actions (2026-08-28,
                                                         receipt revisioning; reworked 2026-09-04 into
                                                         STAGED returns per Baraa's explicit request) —
                                                         − stages one more unit for return (drops the
                                                         line entirely once every unit is staged); Return
                                                         stages the whole remaining line at once. Neither
                                                         touches inventory or the database any more, and
                                                         neither creates a bill revision by itself — they
                                                         only set this line's PendingReturnQuantity (see
                                                         Core.Models.Sells' doc comment on that property).
                                                         Undo (only shown once something's staged on this
                                                         line) clears it back to 0. The actual return only
                                                         happens when Save Returns is pressed below the
                                                         items list, covering every staged line on the
                                                         bill in ONE new revision — see
                                                         BillsBrowserViewModel's "STAGED RETURNS" class doc
                                                         comment for the full reasoning. No "+" here: adding
                                                         units back to an already-sold, possibly-historical
                                                         receipt isn't a return, and doesn't fit this model
                                                         — a genuinely new sale belongs in a fresh Checkout
                                                         cart instead. The −/Return/Undo buttons are hidden
                                                         entirely (IsSelectedBillCurrent) when viewing a
                                                         superseded/historical revision — see the banner
                                                         above this ItemsControl — but the quantity
                                                         TextBlock stays outside that visibility switch and
                                                         always shows: a bug fix (2026-08-29) for a first
                                                         version of this that wrapped BOTH the button and
                                                         the quantity number in the same Visibility binding,
                                                         which meant opening a superseded bill's history hid
                                                         the quantity of every line entirely instead of just
                                                         hiding the return button, per Mahmoud's own report
                                                         after trying it. -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Content="−"
                                                                Command="{Binding DataContext.DecrementLineQuantityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Width="28" Height="28" Padding="0"
                                                                Style="{StaticResource ThemeToggleButtonStyle}"
                                                                Visibility="{Binding DataContext.IsSelectedBillCurrent, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <StackPanel VerticalAlignment="Center" Margin="8,0">
                                                            <!-- Shows what will remain after staged
                                                                 returns save, not the raw sold Quantity
                                                                 — see Core.Models.Sells.RemainingQuantity. -->
                                                            <TextBlock Text="{Binding RemainingQuantity, StringFormat={}{0:0.##}}"
                                                                       Foreground="{DynamicResource OnSurfaceBrush}"
                                                                       TextAlignment="Center"
                                                                       MinWidth="28" />
                                                            <TextBlock Text="{Binding PendingReturnQuantity, StringFormat={}-{0:0.##}}"
                                                                       Style="{StaticResource LabelSmall}"
                                                                       Foreground="{DynamicResource ErrorBrush}"
                                                                       TextAlignment="Center"
                                                                       Visibility="{Binding HasPendingReturn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat={}{0:0.00}}"
                                                               Style="{StaticResource BodyLarge}"
                                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                        <Button Content="{DynamicResource BillsUndoLineReturnButton}"
                                                                Command="{Binding DataContext.UndoLineReturnCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Background="{DynamicResource SurfaceContainerHighBrush}"
                                                                Foreground="{DynamicResource OnSurfaceBrush}"
                                                                Template="{StaticResource SelectableButtonTemplate}"
                                                                Padding="12,8"
                                                                Margin="0,0,8,0"
                                                                Visibility="{Binding HasPendingReturn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <Button Content="{DynamicResource BillsDetailRemoveLineButton}"
                                                                Command="{Binding DataContext.ReturnLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Background="{DynamicResource ErrorContainerBrush}"
                                                                Foreground="{DynamicResource OnErrorContainerBrush}"
                                                                Template="{StaticResource SelectableButtonTemplate}"
                                                                Padding="12,8"
                                                                Visibility="{Binding DataContext.IsSelectedBillCurrent, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Whole-bill return (2026-08-28, receipt revisioning;
                                     reworked 2026-09-04 into staging — see
                                     BillsBrowserViewModel.StageWholeBillReturn) — marks every
                                     line for full return at once, same as clicking Return on
                                     each individually, but still just staging: Save Returns
                                     below is what actually creates the (zero-item) revision.
                                     Hidden for a superseded/historical bill, same as the
                                     line-level actions above. -->
                                <Button Content="{DynamicResource BillsDetailReturnWholeBillButton}"
                                        Command="{Binding ReturnWholeBillCommand}"
                                        Background="{DynamicResource ErrorContainerBrush}"
                                        Foreground="{DynamicResource OnErrorContainerBrush}"
                                        Template="{StaticResource SelectableButtonTemplate}"
                                        Padding="0,14"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,0,0,12"
                                        Visibility="{Binding IsSelectedBillCurrent, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Save Returns bar (2026-09-04, the actual point of the
                                     staged-returns rework requested by Baraa) — the ONLY
                                     thing that commits every −/Return/Return-Whole-Bill stage
                                     made above into a real, single new bill revision (see
                                     BillsBrowserViewModel.SaveReturns). Only visible once
                                     something is actually staged (HasPendingReturns), so a
                                     bill with nothing marked for return looks exactly like it
                                     did before this feature existed. Discard clears every
                                     staged line on this bill without saving any of it. -->
                                <Border Background="{DynamicResource SurfaceContainerBrush}"
                                        CornerRadius="14" Padding="16" Margin="0,0,0,20"
                                        Visibility="{Binding HasPendingReturns, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{DynamicResource BillsPendingReturnsSummary}"
                                                   Style="{StaticResource BodyLarge}"
                                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Content="{DynamicResource BillsDiscardReturnsButton}"
                                                Command="{Binding DiscardReturnsCommand}"
                                                Background="{DynamicResource SurfaceContainerHighBrush}"
                                                Foreground="{DynamicResource OnSurfaceBrush}"
                                                Template="{StaticResource SelectableButtonTemplate}"
                                                Padding="16,10"
                                                Margin="12,0,0,0" />
                                        <Button Grid.Column="2"
                                                Content="{DynamicResource BillsSaveReturnsButton}"
                                                Command="{Binding SaveReturnsCommand}"
                                                Background="{DynamicResource ErrorBrush}"
                                                Foreground="{DynamicResource OnErrorBrush}"
                                                Template="{StaticResource SelectableButtonTemplate}"
                                                Padding="16,10"
                                                Margin="8,0,0,0" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding StatusMessage}"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
