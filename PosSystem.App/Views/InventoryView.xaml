<UserControl x:Class="PosSystem.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PosSystem.App.ViewModels"
             FlowDirection="{DynamicResource AppFlowDirection}">

    <UserControl.DataContext>
        <vm:InventoryViewModel />
    </UserControl.DataContext>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Add-product panel — same shape as CustomersView's add-customer
             panel: fixed 320px, SurfaceContainerLow background, single
             trailing border, heading + section title + fields + button +
             status message. -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource OutlineVariantBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,28,24,20">
                    <TextBlock Text="{DynamicResource InventoryHeading}"
                               Style="{StaticResource HeadlineMedium}"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               Margin="0,0,0,20" />

                    <!-- Admin gate (#7, 2026-08-27 extension) — inline,
                         not a full-screen overlay like Dashboard's: browsing
                         and adjusting stock stay open to any staff member,
                         only Add Product / Manage Categories / per-row Edit
                         and Delete are actually gated (see
                         InventoryViewModel's class doc comment and each
                         gated method's RequireAdminUnlocked() check). Shown
                         only while locked; disappears the moment AdminSession
                         unlocks (from here, Dashboard, or the eventual Excel
                         export — one shared session, see AdminSession). -->
                    <Border Background="{DynamicResource SurfaceContainerHighBrush}"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,0,20"
                            Visibility="{Binding IsAdminLocked, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource InventoryAdminLockedTitle}"
                                       Style="{StaticResource TitleMedium}"
                                       Foreground="{DynamicResource OnSurfaceBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource InventoryAdminLockedSubtitle}"
                                       Style="{StaticResource LabelSmall}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <PasswordBox x:Name="AdminUnlockPasswordBox"
                                         Style="{StaticResource ThemedPasswordBoxStyle}"
                                         PasswordChanged="AdminUnlockPasswordBox_PasswordChanged"
                                         Margin="0,0,0,10" />
                            <Button Content="{DynamicResource DashboardUnlockButton}"
                                    Command="{Binding AdminUnlockCommand}"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Foreground="{DynamicResource OnPrimaryBrush}"
                                    Template="{StaticResource SelectableButtonTemplate}"
                                    Padding="0,10"
                                    HorizontalContentAlignment="Center" />
                            <TextBlock Text="{Binding AdminUnlockError}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource InventoryAddSectionTitle}"
                               Style="{StaticResource TitleMedium}"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               Margin="0,0,0,12" />

                    <TextBlock Text="{DynamicResource InventoryProductNameLabel}"
                               Style="{StaticResource LabelSmall}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ThemedTextBoxStyle}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="{DynamicResource InventoryProductBarcodeLabel}"
                               Style="{StaticResource LabelSmall}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewProductBarcode, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ThemedTextBoxStyle}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="{DynamicResource InventoryProductCategoryLabel}"
                               Style="{StaticResource LabelSmall}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               Margin="0,0,0,4" />
                    <!-- Editable, live-narrowing picker (2026-08-26,
                         replacing the 2026-08-25 selection-only version) —
                         same IsEditable/Text/FilteredOptions/IsDropDownOpen
                         shape as the Category filter ComboBox on the right
                         side of this screen. ItemsSource points at
                         FilteredNewProductCategoryOptions (narrowed live by
                         NewProductCategorySearchText) instead of the full
                         AllCategoryNames, but SelectedItem still only ever
                         gets set by actually picking an item from that
                         narrowed list — typing alone doesn't set it, so a
                         product still can only be saved with a category
                         actually in AllCategoryNames; see
                         InventoryViewModel's class doc comment and
                         AddProduct's validation. -->
                    <ComboBox ItemsSource="{Binding FilteredNewProductCategoryOptions}"
                              SelectedItem="{Binding NewProductCategoryInput, Mode=TwoWay}"
                              Text="{Binding NewProductCategorySearchText, UpdateSourceTrigger=PropertyChanged}"
                              IsDropDownOpen="{Binding IsNewProductCategoryDropDownOpen, Mode=TwoWay}"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="{DynamicResource InventoryProductQuantityLabel}"
                               Style="{StaticResource LabelSmall}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewProductQuantity, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ThemedTextBoxStyle}"
                             Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource InventoryProductCostLabel}"
                                       Style="{StaticResource LabelSmall}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewProductCost, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ThemedTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource InventoryProductPriceLabel}"
                                       Style="{StaticResource LabelSmall}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewProductPrice, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ThemedTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <Button Content="{DynamicResource InventoryAddProductButton}"
                            Command="{Binding AddProductCommand}"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="{DynamicResource OnPrimaryBrush}"
                            Template="{StaticResource SelectableButtonTemplate}"
                            Padding="0,12"
                            HorizontalContentAlignment="Center" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />

                    <!-- Manage categories (moved 2026-08-25 out from between
                         the Add Product form's Category field and Quantity
                         field, where it broke up that form's flow and made
                         it look like part of adding a product rather than a
                         separate, less-frequent management action). Now its
                         own titled section below Add Product, set apart by
                         a divider line. -->
                    <Border BorderBrush="{DynamicResource OutlineVariantBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,24,0,20" />

                    <TextBlock Text="{DynamicResource InventoryManageCategoriesTitle}"
                               Style="{StaticResource TitleMedium}"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ThemedTextBoxStyle}" />
                        <Button Grid.Column="2"
                                Content="{DynamicResource InventoryAddCategoryButton}"
                                Command="{Binding AddCategoryCommand}"
                                Background="{DynamicResource SurfaceContainerHighBrush}"
                                Foreground="{DynamicResource OnSurfaceBrush}"
                                Template="{StaticResource SelectableButtonTemplate}"
                                Padding="12,10" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Editable, live-narrowing picker (2026-08-26) —
                             same pattern as Add Product's category field
                             just above; see InventoryViewModel's
                             FilteredCategoryToDeleteOptions/
                             CategoryToDeleteSearchText and DeleteCategory's
                             existence guard (typing text that doesn't match
                             a real category can't delete anything). -->
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding FilteredCategoryToDeleteOptions}"
                                  SelectedItem="{Binding CategoryToDelete, Mode=TwoWay}"
                                  Text="{Binding CategoryToDeleteSearchText, UpdateSourceTrigger=PropertyChanged}"
                                  IsDropDownOpen="{Binding IsCategoryToDeleteDropDownOpen, Mode=TwoWay}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  Style="{StaticResource ThemedComboBoxStyle}" />
                        <Button Grid.Column="2"
                                Content="{DynamicResource InventoryDeleteCategoryButton}"
                                Command="{Binding DeleteCategoryCommand}"
                                Background="{DynamicResource ErrorContainerBrush}"
                                Foreground="{DynamicResource OnErrorContainerBrush}"
                                Template="{StaticResource SelectableButtonTemplate}"
                                Padding="12,10" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right side: search/filter card + product grid — unchanged from
             before, just moved under this column instead of stacked above
             a full-width grid, matching the Customers screen's two-column
             shape. -->
        <Grid Grid.Column="1" Margin="24,28,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource InventoryListTitle}"
                           Style="{StaticResource TitleMedium}"
                           Foreground="{DynamicResource OnSurfaceBrush}"
                           Margin="0,0,0,12" />

                <!-- Undo / Redo / Save Changes / Discard (2026-09-03,
                     explicit request) - see InventoryViewModel's
                     class doc comment on the staging model these drive.
                     Undo/Redo stay visible but disable themselves
                     (IsEnabled bound to CanUndo/CanRedo) since "nothing to
                     undo right now" is a normal, expected state, not
                     something to hide - but Save/Discard only appear at
                     all once there's actually something pending
                     (Visibility bound to HasUnsavedChanges), since an
                     always-visible disabled Save button next to a product
                     grid with nothing pending would look like it's
                     offering to save something that doesn't exist. -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Discounts page entry point (added 2026-09-04) -
                         same placement idea as Checkout's own Bills browser
                         button (a plain nav button that opens a full-screen
                         overlay, see the Grid at the bottom of this file) -
                         first in this row since it's a whole separate page,
                         not one of the Undo/Redo/Discard/Save Changes group
                         it sits next to. -->
                    <Button Grid.Column="0"
                            Content="{DynamicResource InventoryDiscountsButton}"
                            Command="{Binding OpenDiscountsCommand}"
                            Background="{DynamicResource SurfaceContainerHighBrush}"
                            Foreground="{DynamicResource OnSurfaceBrush}"
                            Template="{StaticResource SelectableButtonTemplate}"
                            Padding="14,8" />
                    <Button Grid.Column="2"
                            Content="{DynamicResource InventoryUndoButton}"
                            Command="{Binding UndoCommand}"
                            IsEnabled="{Binding CanUndo}"
                            Background="{DynamicResource SurfaceContainerHighBrush}"
                            Foreground="{DynamicResource OnSurfaceBrush}"
                            Template="{StaticResource SelectableButtonTemplate}"
                            Padding="14,8" />
                    <Button Grid.Column="4"
                            Content="{DynamicResource InventoryRedoButton}"
                            Command="{Binding RedoCommand}"
                            IsEnabled="{Binding CanRedo}"
                            Background="{DynamicResource SurfaceContainerHighBrush}"
                            Foreground="{DynamicResource OnSurfaceBrush}"
                            Template="{StaticResource SelectableButtonTemplate}"
                            Padding="14,8" />
                    <Button Grid.Column="6"
                            Content="{DynamicResource InventoryDiscardChangesButton}"
                            Command="{Binding DiscardChangesCommand}"
                            Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{DynamicResource ErrorContainerBrush}"
                            Foreground="{DynamicResource OnErrorContainerBrush}"
                            Template="{StaticResource SelectableButtonTemplate}"
                            Padding="14,8" />
                    <Button Grid.Column="8"
                            Content="{DynamicResource InventorySaveChangesButton}"
                            Command="{Binding SaveChangesCommand}"
                            Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="{DynamicResource OnPrimaryBrush}"
                            Template="{StaticResource SelectableButtonTemplate}"
                            Padding="14,8" />
                </Grid>

                <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource InventorySearchLabel}"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ThemedTextBoxStyle}"
                                 Margin="0,0,0,14" />

                        <TextBlock Text="{DynamicResource InventoryStockFilterLabel}"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding StockFilters}"
                                 SelectedItem="{Binding SelectedStockFilter, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 Margin="0,0,0,14"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource CategoryChipListBoxItemStyle}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Category filter — wide, type-to-search dropdown
                             (2026-08-26): editable ComboBox bound to
                             CategorySearchText, with ItemsSource pointed at
                             FilteredCategoryOptions (narrowed live as the
                             user types) instead of the full Categories list.
                             See InventoryViewModel.RebuildFilteredCategories
                             for the filtering logic. -->
                        <TextBlock Text="{DynamicResource DashboardCategoryFilterLabel}"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding FilteredCategoryOptions}"
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  Text="{Binding CategorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                  IsDropDownOpen="{Binding IsCategoryDropDownOpen, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  Style="{StaticResource ThemedComboBoxStyle}" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsAllVisibleSelected, Mode=TwoWay}"
                              Content="{DynamicResource InventorySelectAllLabel}"
                              Style="{StaticResource ThemedCheckBoxStyle}"
                              VerticalAlignment="Center" />
                </Grid>

                <Border Background="{DynamicResource SurfaceContainerHighBrush}"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,10,0,0"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource InventorySelectedCountLabel}"
                                       Style="{StaticResource LabelSmall}"
                                       Foreground="{DynamicResource OnSurfaceBrush}"
                                       Margin="0,0,4,0" />
                            <TextBlock Text="{Binding SelectedCount}"
                                       Style="{StaticResource LabelSmall}"
                                       Foreground="{DynamicResource OnSurfaceBrush}"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <!-- Label added 2026-09-04 - this was the only
                             input on the whole screen with no caption above
                             it, so an empty ComboBox with nothing but a
                             chevron just looked broken/blank until clicked
                             (flagged via screenshot). Same LabelSmall/
                             OnSurfaceVariantBrush caption pattern every
                             other field on this screen already uses. -->
                        <TextBlock Text="{DynamicResource InventoryBulkCategoryPickerLabel}"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AllCategoryNames}"
                                  SelectedItem="{Binding BulkCategoryTarget, Mode=TwoWay}"
                                  Style="{StaticResource ThemedComboBoxStyle}"
                                  Margin="0,0,0,10" />

                        <!-- Bulk discount (added 2026-09-04) - a plain %
                             TextBox next to the category picker above,
                             same "one input, one action button" shape.
                             Overwrites any existing discount on every
                             selected product (see InventoryViewModel.
                             BulkAddDiscounts' comment for why that's correct
                             given a product can never have more than one
                             discount at a time). -->
                        <TextBlock Text="{DynamicResource InventoryBulkDiscountPercentLabel}"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding BulkDiscountPercentInput, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ThemedTextBoxStyle}"
                                 Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="{DynamicResource InventoryBulkChangeCategoryButton}"
                                    Command="{Binding BulkChangeCategoryCommand}"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Foreground="{DynamicResource OnPrimaryBrush}"
                                    Template="{StaticResource SelectableButtonTemplate}"
                                    Padding="0,10"
                                    HorizontalContentAlignment="Center" />
                            <Button Grid.Column="2"
                                    Content="{DynamicResource InventoryBulkAddDiscountsButton}"
                                    Command="{Binding BulkAddDiscountsCommand}"
                                    Background="{DynamicResource TertiaryContainerBrush}"
                                    Foreground="{DynamicResource OnTertiaryContainerBrush}"
                                    Template="{StaticResource SelectableButtonTemplate}"
                                    Padding="0,10"
                                    HorizontalContentAlignment="Center" />
                        </Grid>

                        <Button Content="{DynamicResource InventoryBulkDeleteButton}"
                                Command="{Binding BulkDeleteCommand}"
                                Background="{DynamicResource ErrorContainerBrush}"
                                Foreground="{DynamicResource OnErrorContainerBrush}"
                                Template="{StaticResource SelectableButtonTemplate}"
                                Padding="0,10"
                                HorizontalContentAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Product grid -->
            <Grid Grid.Row="1">
                <TextBlock Text="{DynamicResource InventoryNoResults}"
                           Style="{StaticResource BodyLarge}"
                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Visibility="{Binding Rows.Count, Converter={StaticResource CountToVisibilityConverter}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="260" Margin="0,0,16,16"
                                        CornerRadius="14"
                                        Padding="18"
                                        Background="{DynamicResource SurfaceContainerBrush}">
                                    <Grid>

                                    <!-- ============ VIEW MODE ============
                                         Everything that was already here,
                                         unchanged, plus an Edit button added
                                         to the header row. Hidden (not just
                                         the Edit button) while this row is
                                         being edited, via IsNotEditing.
                                         Same Visible/Collapsed swap pattern
                                         CustomersView.xaml already uses for
                                         its list-vs-detail views, applied
                                         per-card here instead of per-screen. -->
                                    <StackPanel Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Batch selection checkbox (added 2026-08-31;
                                                 themed 2026-09-04 to match the Access Control
                                                 checkboxes on Settings instead of the unstyled
                                                 default WPF checkbox it was rendering as) -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource ThemedCheckBoxStyle}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Category}"
                                                       Style="{StaticResource LabelSmall}"
                                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="2"
                                                    Content="{DynamicResource InventoryEditButton}"
                                                    Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource SurfaceContainerHighBrush}"
                                                    Foreground="{DynamicResource OnSurfaceBrush}"
                                                    Template="{StaticResource SelectableButtonTemplate}"
                                                    Padding="10,4" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource TitleMedium}"
                                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,10" />

                                        <!-- Discount badge (added 2026-09-04) -
                                             only rendered when this product actually
                                             has one (InventoryRow.HasDiscount), so a
                                             shop that never uses discounts sees the
                                             card exactly as it looked before this
                                             feature existed. -->
                                        <Border CornerRadius="6" Padding="8,3" Margin="0,0,0,8"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource TertiaryContainerBrush}"
                                                Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{DynamicResource InventoryDiscountBadge}"
                                                           Foreground="{DynamicResource OnTertiaryContainerBrush}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding DiscountPercent, StringFormat={}-{0:0.##}%}"
                                                           Foreground="{DynamicResource OnTertiaryContainerBrush}"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Price display (rewritten 2026-09-04 for
                                                 discounts) - two mutually-exclusive states
                                                 instead of always showing the plain Price,
                                                 same TertiaryBrush/"-{0:0.00}" convention
                                                 CheckoutView.xaml's own Discount line already
                                                 uses (the explicit visual reference for this
                                                 feature), so a discounted product's card and
                                                 the discount line at Checkout read the same
                                                 way. -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                        Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Price, StringFormat={}{0:0.00}}"
                                                               Style="{StaticResource BodyLarge}"
                                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                               TextDecorations="Strikethrough"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding DiscountedPrice, StringFormat={}{0:0.00}}"
                                                               Style="{StaticResource TitleMedium}"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding DiscountAmount, StringFormat={}-{0:0.00}}"
                                                           Style="{StaticResource LabelSmall}"
                                                           Foreground="{DynamicResource TertiaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Price, StringFormat={}{0:0.00}}"
                                                       Style="{StaticResource TitleMedium}"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasDiscount, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            <!-- Two elements, not one MultiBinding-with-a-
                                                 localized-label-as-Source: Binding.Source
                                                 can't take a DynamicResource (Binding isn't a
                                                 DependencyObject, so it would resolve once at
                                                 load and never update on a language toggle) —
                                                 a real bug caught before it shipped, not a
                                                 style preference. -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource InventoryQuantityLabel}"
                                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                           Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding Quantity, StringFormat={}{0:0.##}}"
                                                           Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Stock-status badge. Same
                                             Border+DataTrigger pattern as
                                             Customers' debt badge — Tertiary for
                                             low stock (matches Colors.Light.xaml's
                                             own documented "discount badges,
                                             low-stock flags" role for that
                                             token), Error for out of stock. -->
                                        <Border CornerRadius="8" Padding="10,6" Margin="0,0,0,12"
                                                HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TertiaryContainerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ErrorContainerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
                                                        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
                                                        <Setter Property="Text" Value="{DynamicResource InventoryStatusInStock}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource OnTertiaryContainerBrush}" />
                                                                <Setter Property="Text" Value="{DynamicResource InventoryStatusLowStock}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource OnErrorContainerBrush}" />
                                                                <Setter Property="Text" Value="{DynamicResource InventoryStatusOutOfStock}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Inline quantity adjustment -->
                                        <TextBlock Text="{DynamicResource InventoryAdjustLabel}"
                                                   Style="{StaticResource LabelSmall}"
                                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                   Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding AdjustInput, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ThemedTextBoxStyle}"
                                                     Margin="0,0,8,0" />
                                            <Button Grid.Column="1"
                                                    Content="{DynamicResource InventoryAdjustButton}"
                                                    Command="{Binding DataContext.AdjustQuantityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource PrimaryBrush}"
                                                    Foreground="{DynamicResource OnPrimaryBrush}"
                                                    Template="{StaticResource SelectableButtonTemplate}"
                                                    Padding="12,8" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- ============ EDIT MODE ============
                                         Quantity deliberately has no field
                                         here, see InventoryRow's class doc
                                         comment for why the existing Adjust-
                                         quantity mini-form above already owns
                                         that field end-to-end and conflating
                                         the two is a real risk, not just
                                         redundancy. Category is a selection-
                                         only ComboBox, same reasoning and
                                         same AllCategoryNames source as Add
                                         Product's category field, reached
                                         here via the ItemsControl's
                                         DataContext since AllCategoryNames
                                         lives on InventoryViewModel, not on
                                         this row. -->
                                    <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{DynamicResource InventoryProductNameLabel}"
                                                   Style="{StaticResource LabelSmall}"
                                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ThemedTextBoxStyle}"
                                                 Margin="0,0,0,10" />

                                        <TextBlock Text="{DynamicResource InventoryProductBarcodeLabel}"
                                                   Style="{StaticResource LabelSmall}"
                                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditBarcode, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ThemedTextBoxStyle}"
                                                 Margin="0,0,0,10" />

                                        <TextBlock Text="{DynamicResource InventoryProductCategoryLabel}"
                                                   Style="{StaticResource LabelSmall}"
                                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                   Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding DataContext.AllCategoryNames, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  SelectedItem="{Binding EditCategoryInput, Mode=TwoWay}"
                                                  Style="{StaticResource ThemedComboBoxStyle}"
                                                  Margin="0,0,0,10" />

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource InventoryProductCostLabel}"
                                                           Style="{StaticResource LabelSmall}"
                                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                           Margin="0,0,0,4" />
                                                <TextBox Text="{Binding EditCost, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ThemedTextBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource InventoryProductPriceLabel}"
                                                           Style="{StaticResource LabelSmall}"
                                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                           Margin="0,0,0,4" />
                                                <TextBox Text="{Binding EditPrice, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ThemedTextBoxStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Content="{DynamicResource InventoryEditCancelButton}"
                                                    Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource SurfaceContainerHighBrush}"
                                                    Foreground="{DynamicResource OnSurfaceBrush}"
                                                    Template="{StaticResource SelectableButtonTemplate}"
                                                    Padding="0,10"
                                                    HorizontalContentAlignment="Center" />
                                            <Button Grid.Column="2"
                                                    Content="{DynamicResource InventoryEditSaveButton}"
                                                    Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource PrimaryBrush}"
                                                    Foreground="{DynamicResource OnPrimaryBrush}"
                                                    Template="{StaticResource SelectableButtonTemplate}"
                                                    Padding="0,10"
                                                    HorizontalContentAlignment="Center" />
                                        </Grid>

                                        <!-- Delete Product. Set apart below
                                             Cancel/Save with extra top margin
                                             and Error-container coloring
                                             (same styling as the Delete
                                             Category button on the left
                                             panel) so it doesn't sit at the
                                             same visual weight as Save and
                                             invite an accidental click. -->
                                        <Button Content="{DynamicResource InventoryDeleteProductButton}"
                                                Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="{DynamicResource ErrorContainerBrush}"
                                                Foreground="{DynamicResource OnErrorContainerBrush}"
                                                Template="{StaticResource SelectableButtonTemplate}"
                                                Padding="0,10"
                                                Margin="0,10,0,0"
                                                HorizontalContentAlignment="Center" />
                                    </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================= Discounts browser overlay (added 2026-09-04) =================
             Covers the whole screen (both columns), same Panel.ZIndex/
             full-Border-over-BackgroundBrush trick as Checkout's Bills
             browser overlay in CheckoutView.xaml - toggled by a plain bool
             (IsDiscountsBrowserOpen) rather than a null-object DataTrigger
             since this reuses InventoryViewModel directly instead of a
             separate ViewModel class (see that property's own doc comment
             for why). DataContext is NOT reassigned here (unlike Checkout's
             version) - every binding below is still against
             InventoryViewModel itself, which is exactly what's needed since
             DiscountedRows/BulkDiscountPercentInput-equivalent per-row edit
             fields/SaveDiscountEditCommand/RemoveDiscountCommand all live
             there. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Panel.ZIndex="20"
              FlowDirection="{DynamicResource AppFlowDirection}"
              Visibility="{Binding IsDiscountsBrowserOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource BackgroundBrush}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource DiscountsBrowserTitle}"
                                   Style="{StaticResource HeadlineMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}" />
                        <Button Grid.Column="1"
                                Content="{DynamicResource DiscountsBrowserCloseButton}"
                                Command="{Binding CloseDiscountsCommand}"
                                Background="{DynamicResource SurfaceContainerHighBrush}"
                                Foreground="{DynamicResource OnSurfaceBrush}"
                                Template="{StaticResource SelectableButtonTemplate}"
                                Padding="14,8" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBlock Text="{DynamicResource DiscountsBrowserNoResults}"
                                   Style="{StaticResource BodyLarge}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding DiscountedRows.Count, Converter={StaticResource CountToVisibilityConverter}}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DiscountedRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceContainerBrush}"
                                                CornerRadius="12" Padding="16" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource BodyLarge}"
                                                               Foreground="{DynamicResource OnSurfaceBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Category}"
                                                               Style="{StaticResource LabelSmall}"
                                                               Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                                </StackPanel>

                                                <!-- Original price, struck through - same
                                                     visual language as the product card. -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Price, StringFormat={}{0:0.00}}"
                                                           Style="{StaticResource BodyLarge}"
                                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                           TextDecorations="Strikethrough"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center" />

                                                <!-- New (discounted) price + the currency amount
                                                     taken off, same TertiaryBrush/"-{0:0.00}"
                                                     convention as Checkout's own Discount line. -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DiscountedPrice, StringFormat={}{0:0.00}}"
                                                               Style="{StaticResource BodyLarge}"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               TextAlignment="Center" />
                                                    <TextBlock Text="{Binding DiscountAmount, StringFormat={}-{0:0.00}}"
                                                               Style="{StaticResource LabelSmall}"
                                                               Foreground="{DynamicResource TertiaryBrush}"
                                                               TextAlignment="Center" />
                                                </StackPanel>

                                                <!-- Editable % - DiscountEditInput is this row's
                                                     own typed-in buffer (see InventoryRow's doc
                                                     comment), only committed to the real
                                                     DiscountPercent when Save below is clicked. -->
                                                <TextBox Grid.Column="3"
                                                         Text="{Binding DiscountEditInput, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ThemedTextBoxStyle}"
                                                         HorizontalContentAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Margin="8,0" />

                                                <Button Grid.Column="4"
                                                        Content="{DynamicResource DiscountsBrowserSaveButton}"
                                                        Command="{Binding DataContext.SaveDiscountEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="{DynamicResource PrimaryBrush}"
                                                        Foreground="{DynamicResource OnPrimaryBrush}"
                                                        Template="{StaticResource SelectableButtonTemplate}"
                                                        Padding="12,8"
                                                        Margin="0,0,8,0" />
                                                <Button Grid.Column="5"
                                                        Content="{DynamicResource DiscountsBrowserRemoveButton}"
                                                        Command="{Binding DataContext.RemoveDiscountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="{DynamicResource ErrorContainerBrush}"
                                                        Foreground="{DynamicResource OnErrorContainerBrush}"
                                                        Template="{StaticResource SelectableButtonTemplate}"
                                                        Padding="12,8" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,4" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
