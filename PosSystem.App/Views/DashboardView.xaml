<UserControl x:Class="PosSystem.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PosSystem.App.ViewModels"
             FlowDirection="{DynamicResource AppFlowDirection}">

    <UserControl.DataContext>
        <vm:DashboardViewModel />
    </UserControl.DataContext>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <TextBlock Text="{DynamicResource DashboardHeading}"
                       Style="{StaticResource DisplayLarge}"
                       Foreground="{DynamicResource OnSurfaceBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource DashboardDescription}"
                       Style="{StaticResource BodyLarge}"
                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,8,0,24" />
            <Border Background="{DynamicResource SurfaceContainerBrush}"
                    CornerRadius="16"
                    Padding="24">
                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource BodyLarge}"
                           Foreground="{DynamicResource OnSurfaceBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
