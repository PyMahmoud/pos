<UserControl x:Class="PosSystem.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PosSystem.App.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             FlowDirection="{DynamicResource AppFlowDirection}">

    <UserControl.DataContext>
        <vm:DashboardViewModel />
    </UserControl.DataContext>

    <ScrollViewer Background="{DynamicResource BackgroundBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{DynamicResource DashboardHeading}"
                           Style="{StaticResource DisplayLarge}"
                           Foreground="{DynamicResource OnSurfaceBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding LastUpdatedText, StringFormat={}Updated {0}}"
                           Style="{StaticResource LabelSmall}"
                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                           VerticalAlignment="Bottom" />
            </Grid>

            <!-- Every KPI/chart below reflects this range — shown once,
                 here, so a number is never on screen without saying what
                 period it covers (Dashboard-Parity-Plan.md Usability rules). -->
            <TextBlock Text="{Binding ActiveRangeText}"
                       Style="{StaticResource BodyLarge}"
                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                       Margin="0,0,0,16" />

            <!-- ================= Filter bar (Stage 2 + Stage 3) ================= -->
            <!-- Every control here is a plain WPF button/chip/date-picker —
                 nothing depends on clicking a chart element. See the
                 class-level comment in DashboardViewModel for why. -->
            <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,20">
                <StackPanel>

                    <!-- Quick range + custom date pickers -->
                    <TextBlock Text="{DynamicResource DashboardFilterRangeLabel}"
                               Style="{StaticResource LabelSmall}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               Margin="0,0,0,6" />
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="{DynamicResource DashboardRangeToday}"
                                Command="{Binding SetQuickRangeCommand}"
                                CommandParameter="{x:Static vm:DashboardQuickRange.Today}"
                                Style="{StaticResource RangeTodayButtonStyle}"
                                Padding="14,8" Margin="0,0,8,8" />
                        <Button Content="{DynamicResource DashboardRangeThisWeek}"
                                Command="{Binding SetQuickRangeCommand}"
                                CommandParameter="{x:Static vm:DashboardQuickRange.ThisWeek}"
                                Style="{StaticResource RangeWeekButtonStyle}"
                                Padding="14,8" Margin="0,0,8,8" />
                        <Button Content="{DynamicResource DashboardRangeThisMonth}"
                                Command="{Binding SetQuickRangeCommand}"
                                CommandParameter="{x:Static vm:DashboardQuickRange.ThisMonth}"
                                Style="{StaticResource RangeMonthButtonStyle}"
                                Padding="14,8" Margin="0,0,8,8" />
                        <Button Content="{DynamicResource DashboardRangeLast30}"
                                Command="{Binding SetQuickRangeCommand}"
                                CommandParameter="{x:Static vm:DashboardQuickRange.Last30Days}"
                                Style="{StaticResource RangeLast30ButtonStyle}"
                                Padding="14,8" Margin="0,0,8,8" />
                        <Button Content="{DynamicResource DashboardRangeAllTime}"
                                Command="{Binding SetQuickRangeCommand}"
                                CommandParameter="{x:Static vm:DashboardQuickRange.AllTime}"
                                Style="{StaticResource RangeAllTimeButtonStyle}"
                                Padding="14,8" Margin="0,0,16,8" />

                        <!-- Two prebuilt rows instead of one auto-mirrored
                             one: FlowDirection-based mirroring wasn't giving
                             a reliable result for this specific reordering
                             (box-before-label, not just left/right swap), so
                             each language gets its own explicit, fixed
                             element order, gated by EnglishOnlyVisibility /
                             ArabicOnlyVisibility (set directly by
                             LocalizationManager.SwitchLanguage). Both are
                             pinned FlowDirection=LeftToRight so nothing here
                             depends on inherited mirroring at all. -->

                        <!-- English: label, box, label, box (unchanged from before) -->
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight"
                                    Visibility="{DynamicResource EnglishOnlyVisibility}"
                                    Margin="0,0,16,8" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource DashboardFilterFromLabel}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <DatePicker SelectedDate="{Binding FilterStartDate, Mode=TwoWay}" Style="{StaticResource ThemedDatePickerStyle}" />
                            <TextBlock Text="{DynamicResource DashboardFilterToLabel}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       VerticalAlignment="Center" Margin="14,0,6,0" />
                            <DatePicker SelectedDate="{Binding FilterEndDate, Mode=TwoWay}" Style="{StaticResource ThemedDatePickerStyle}" />
                        </StackPanel>

                        <!-- Arabic: the whole block order is swapped, not just
                             label/box within a pair. "من" is read first in
                             من...إلى so its pair must be the rightmost block on
                             screen, with "إلى"'s pair to its left. Physical
                             left-to-right: [to box][إلى][from box][من]. -->
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight"
                                    Visibility="{DynamicResource ArabicOnlyVisibility}"
                                    Margin="0,0,16,8" VerticalAlignment="Center">
                            <DatePicker SelectedDate="{Binding FilterEndDate, Mode=TwoWay}" Style="{StaticResource ThemedDatePickerStyle}" />
                            <TextBlock Text="{DynamicResource DashboardFilterToLabel}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       VerticalAlignment="Center" Margin="6,0,14,0" />
                            <DatePicker SelectedDate="{Binding FilterStartDate, Mode=TwoWay}" Style="{StaticResource ThemedDatePickerStyle}" />
                            <TextBlock Text="{DynamicResource DashboardFilterFromLabel}"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- Payment method chips -->
                    <TextBlock Text="{DynamicResource DashboardPaymentFilterLabel}"
                               Style="{StaticResource LabelSmall}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding PaymentChips}"
                             SelectedItem="{Binding SelectedPaymentChip, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             Margin="0,0,0,14"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource CategoryChipListBoxItemStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Category chips — built from real data (Checkout's
                         RebuildCategoryChips pattern), same as Checkout. -->
                    <TextBlock Text="{DynamicResource DashboardCategoryFilterLabel}"
                               Style="{StaticResource LabelSmall}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding CategoryChips}"
                                 SelectedItem="{Binding SelectedCategoryChip, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource CategoryChipListBoxItemStyle}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Usability rule: every filter needs an obvious
                             clear/reset affordance. -->
                        <Button Grid.Column="1"
                                Content="{DynamicResource DashboardClearFilters}"
                                Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource ThemeToggleButtonStyle}"
                                Padding="14,8" VerticalAlignment="Top" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= KPI cards ================= -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="16" Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DashboardTodayRevenue}"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FilteredRevenue, StringFormat={}{0:0.00}}"
                                   Style="{StaticResource HeadlineMedium}"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="16" Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DashboardTodayProfit}"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FilteredProfit, StringFormat={}{0:0.00}}"
                                   Style="{StaticResource HeadlineMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="16" Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DashboardTodayTransactions}"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FilteredTransactionCount}"
                                   Style="{StaticResource HeadlineMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="16" Padding="18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DashboardOutstandingDebt}"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding OutstandingDebtTotal, StringFormat={}{0:0.00}}"
                                   Style="{StaticResource HeadlineMedium}"
                                   Foreground="{DynamicResource TertiaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ================= Charts ================= -->
            <!-- Revenue trend — full width. Same card treatment
                 (SurfaceContainerBrush, 16px radius, 20px padding,
                 TitleMedium heading) as every other chart card, per
                 Dashboard-Parity-Plan.md's design-system rule. -->
            <Border Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="260" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource DashboardRevenueTrendTitle}"
                               Style="{StaticResource TitleMedium}"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               Margin="0,0,0,12" />
                    <lvc:CartesianChart Grid.Row="1"
                                         Series="{Binding RevenueTrendSeries}"
                                         XAxes="{Binding RevenueTrendXAxes}"
                                         YAxes="{Binding RevenueTrendYAxes}"
                                         Background="Transparent"
                                         TooltipBackgroundPaint="{Binding ChartTooltipBackgroundPaint}"
                                         TooltipTextPaint="{Binding ChartTooltipTextPaint}" />
                </Grid>
            </Border>

            <!-- Revenue by Category — new in Stage 3, matches the reference's
                 same-named panel. Full width, its own row, so it reads
                 clearly rather than being squeezed next to two other charts
                 (Usability rule: don't overcrowd). -->
            <Border Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="260" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource DashboardCategoryRevenueTitle}"
                               Style="{StaticResource TitleMedium}"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               Margin="0,0,0,12" />
                    <lvc:CartesianChart Grid.Row="1"
                                         Series="{Binding CategoryRevenueSeries}"
                                         XAxes="{Binding CategoryRevenueXAxes}"
                                         YAxes="{Binding CategoryRevenueYAxes}"
                                         Background="Transparent"
                                         TooltipBackgroundPaint="{Binding ChartTooltipBackgroundPaint}"
                                         TooltipTextPaint="{Binding ChartTooltipTextPaint}" />
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="16" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="280" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{DynamicResource DashboardTopItemsTitle}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   Margin="0,0,0,12" />
                        <lvc:CartesianChart Grid.Row="1"
                                             Series="{Binding TopItemsSeries}"
                                             XAxes="{Binding TopItemsXAxes}"
                                             YAxes="{Binding TopItemsYAxes}"
                                             Background="Transparent"
                                             TooltipBackgroundPaint="{Binding ChartTooltipBackgroundPaint}"
                                             TooltipTextPaint="{Binding ChartTooltipTextPaint}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="16" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="280" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{DynamicResource DashboardPaymentSplitTitle}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   Margin="0,0,0,12" />
                        <lvc:PieChart Grid.Row="1"
                                      Series="{Binding PaymentSplitSeries}"
                                      LegendPosition="Right"
                                      LegendTextPaint="{Binding ChartLegendTextPaint}"
                                      Background="Transparent"
                                      TooltipBackgroundPaint="{Binding ChartTooltipBackgroundPaint}"
                                      TooltipTextPaint="{Binding ChartTooltipTextPaint}" />
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Text="{DynamicResource DashboardNoDataYet}"
                       Style="{StaticResource BodyLarge}"
                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,20,0,0"
                       Visibility="{Binding NoDataYet, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
