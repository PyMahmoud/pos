<UserControl x:Class="PosSystem.App.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PosSystem.App.ViewModels"
             FlowDirection="{DynamicResource AppFlowDirection}">

    <UserControl.DataContext>
        <vm:CustomersViewModel />
    </UserControl.DataContext>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Add-customer panel -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource OutlineVariantBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="24,28,24,20">
                <TextBlock Text="{DynamicResource CustomersHeading}"
                           Style="{StaticResource HeadlineMedium}"
                           Foreground="{DynamicResource OnSurfaceBrush}"
                           Margin="0,0,0,20" />

                <TextBlock Text="{DynamicResource CustomersAddSectionTitle}"
                           Style="{StaticResource TitleMedium}"
                           Foreground="{DynamicResource OnSurfaceBrush}"
                           Margin="0,0,0,12" />

                <TextBlock Text="{DynamicResource CustomersNameField}"
                           Style="{StaticResource LabelSmall}"
                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                           Margin="0,0,0,4" />
                <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ThemedTextBoxStyle}"
                         Margin="0,0,0,12" />

                <TextBlock Text="{DynamicResource CustomersPhoneField}"
                           Style="{StaticResource LabelSmall}"
                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                           Margin="0,0,0,4" />
                <TextBox Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ThemedTextBoxStyle}"
                         Margin="0,0,0,12" />

                <TextBlock Text="{DynamicResource CustomersCodeField}"
                           Style="{StaticResource LabelSmall}"
                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                           Margin="0,0,0,4" />
                <TextBox Text="{Binding NewCustomerCode, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ThemedTextBoxStyle}"
                         Margin="0,0,0,16" />

                <Button Content="{DynamicResource CustomersAddButton}"
                        Command="{Binding AddCustomerCommand}"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="{DynamicResource OnPrimaryBrush}"
                        Template="{StaticResource SelectableButtonTemplate}"
                        Padding="0,12"
                        HorizontalContentAlignment="Center" />

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- Right side: either the customer list, or one customer's detail
             drill-down. Both occupy the same cell; only one is Visible at a
             time based on whether SelectedDetail is null, via the {x:Null}
             DataTrigger trick below — avoids needing a dedicated
             null-to-visibility converter for just this one screen. -->
        <Grid Grid.Column="1" Margin="24,28,24,20">

            <!-- ============ CUSTOMER LIST ============ -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedDetail}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource CustomersListTitle}"
                               Style="{StaticResource TitleMedium}"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource CustomersSearchLabel}"
                               Style="{StaticResource LabelSmall}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ThemedTextBoxStyle}" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <TextBlock Text="{DynamicResource CustomersNoResults}"
                               Style="{StaticResource BodyLarge}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               Visibility="{Binding Customers.Count, Converter={StaticResource CountToVisibilityConverter}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Customers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="280" Margin="0,0,16,16"
                                            CornerRadius="14"
                                            Padding="18"
                                            Background="{DynamicResource SurfaceContainerBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Ownername}"
                                                       Style="{StaticResource TitleMedium}"
                                                       Foreground="{DynamicResource OnSurfaceBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                       Style="{StaticResource LabelSmall}"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}   {1}">
                                                        <Binding Path="Ownernumber" />
                                                        <Binding Path="Ownerid" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <!-- Balance badge -->
                                            <Border CornerRadius="8" Padding="10,6" Margin="0,12,0,0"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDebt}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource TertiaryContainerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
                                                            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasDebt}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource OnTertiaryContainerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource CustomerBalanceTextConverter}">
                                                            <Binding Path="Remain" />
                                                            <Binding Path="DataContext.CurrentLanguage" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>

                                            <!-- "Money we owe the customer" badge (added 2026-08-31) -- the
                                                 flip side of the debt badge above. Only shown once CreditOwed
                                                 is actually above 0 (PositiveNumberToVisibilityConverter),
                                                 so a customer with no credit looks exactly as before. Uses a
                                                 plain StringFormat rather than a converter like
                                                 CustomerBalanceTextConverter -- there's no "zero" case to
                                                 special-case in text the way "Paid up" is for Remain, since
                                                 this badge is hidden entirely at zero. -->
                                            <Border CornerRadius="8" Padding="10,6" Margin="0,8,0,0"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource PrimaryContainerBrush}"
                                                    Visibility="{Binding CreditOwed, Converter={StaticResource PositiveNumberToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource CustomersWeOweLabel}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource OnPrimaryContainerBrush}"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding CreditOwed, StringFormat={}{0:0.00}}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource OnPrimaryContainerBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Record payment (only meaningful when there's a balance) -->
                                            <Grid Margin="0,14,0,0"
                                                  Visibility="{Binding HasDebt, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0"
                                                           Text="{DynamicResource CustomersPaymentAmountLabel}"
                                                           Style="{StaticResource LabelSmall}"
                                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                           Margin="0,0,0,4" />
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding PaymentInput, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource ThemedTextBoxStyle}"
                                                             Margin="0,0,8,0" />
                                                    <Button Grid.Column="1"
                                                            Content="{DynamicResource CustomersRecordPaymentButton}"
                                                            Command="{Binding DataContext.RecordPaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="{DynamicResource PrimaryBrush}"
                                                            Foreground="{DynamicResource OnPrimaryBrush}"
                                                            Template="{StaticResource SelectableButtonTemplate}"
                                                            Padding="12,8" />
                                                </Grid>
                                            </Grid>

                                            <Button Content="{DynamicResource CustomersViewDetailsButton}"
                                                    Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource SurfaceContainerHighBrush}"
                                                    Foreground="{DynamicResource OnSurfaceBrush}"
                                                    Template="{StaticResource SelectableButtonTemplate}"
                                                    Padding="0,10"
                                                    Margin="0,10,0,0"
                                                    HorizontalContentAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ============ CUSTOMER DETAIL ============ -->
            <Grid DataContext="{Binding SelectedDetail}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Header -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Customer.Ownername}"
                                       Style="{StaticResource HeadlineMedium}"
                                       Foreground="{DynamicResource OnSurfaceBrush}"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="1"
                                    Content="{DynamicResource CustomerDetailBackButton}"
                                    Command="{Binding CloseCommand}"
                                    Background="{DynamicResource SurfaceContainerHighBrush}"
                                    Foreground="{DynamicResource OnSurfaceBrush}"
                                    Template="{StaticResource SelectableButtonTemplate}"
                                    Padding="14,10"
                                    VerticalAlignment="Top" />
                        </Grid>

                        <!-- Balance summary (added 2026-08-31) -- both
                             directions of balance in one place: what this
                             customer owes the shop (Remain) and what the
                             shop owes them back (CreditOwed), each only
                             shown when actually nonzero. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border CornerRadius="8" Padding="12,8" Margin="0,0,10,0"
                                    Background="{DynamicResource TertiaryContainerBrush}"
                                    Visibility="{Binding HasDebt, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource CustomerDetailOwesLabel}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource OnTertiaryContainerBrush}"
                                               Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding Remain, StringFormat={}{0:0.00}}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource OnTertiaryContainerBrush}" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="8" Padding="12,8"
                                    Background="{DynamicResource PrimaryContainerBrush}"
                                    Visibility="{Binding HasCredit, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource CustomersWeOweLabel}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource OnPrimaryContainerBrush}"
                                               Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding CreditOwed, StringFormat={}{0:0.00}}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource OnPrimaryContainerBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Default discount (2026-09-01) -- this customer's
                             standing discount percentage, gated behind
                             AppSettings.GateDiscountEnabled the same way as
                             every other admin-gated section. See
                             CustomerDetailViewModel's discount fields for
                             the full design. -->
                        <TextBlock Text="{DynamicResource CustomerDetailDiscountTitle}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource CustomerDetailDiscountSubtitle}"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <Border Background="{DynamicResource SurfaceContainerBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,24">
                            <StackPanel>
                                <!-- Locked state -->
                                <StackPanel Visibility="{Binding IsDiscountLocked, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{DynamicResource CustomerDetailDiscountAdminRequired}"
                                               Style="{StaticResource BodyLarge}"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox Grid.Column="0"
                                                     x:Name="DiscountUnlockPasswordBox"
                                                     Style="{StaticResource ThemedPasswordBoxStyle}"
                                                     PasswordChanged="DiscountUnlockPasswordBox_PasswordChanged" />
                                        <Button Grid.Column="2"
                                                Content="{DynamicResource DashboardUnlockButton}"
                                                Command="{Binding DiscountUnlockCommand}"
                                                Background="{DynamicResource PrimaryBrush}"
                                                Foreground="{DynamicResource OnPrimaryBrush}"
                                                Template="{StaticResource SelectableButtonTemplate}"
                                                Padding="16,8" />
                                    </Grid>
                                    <TextBlock Text="{Binding DiscountUnlockError}"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>

                                <!-- Unlocked state -->
                                <StackPanel Visibility="{Binding IsDiscountUnlocked, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{DynamicResource CustomerDetailDiscountLabel}"
                                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding DiscountPercentInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ThemedTextBoxStyle}"
                                                 HorizontalContentAlignment="Right" />
                                    </Grid>
                                    <Button Content="{DynamicResource CustomerDetailDiscountSaveButton}"
                                            Command="{Binding SaveDiscountCommand}"
                                            Background="{DynamicResource PrimaryBrush}"
                                            Foreground="{DynamicResource OnPrimaryBrush}"
                                            Template="{StaticResource SelectableButtonTemplate}"
                                            Padding="0,12"
                                            HorizontalContentAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Medications sold -->
                        <TextBlock Text="{DynamicResource CustomerDetailSoldTitle}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="{DynamicResource CustomerDetailSoldNone}"
                                   Style="{StaticResource BodyLarge}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   Margin="0,0,0,20"
                                   Visibility="{Binding SoldMedications.Count, Converter={StaticResource CountToVisibilityConverter}}" />

                        <Border Background="{DynamicResource SurfaceContainerBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,24"
                                Visibility="{Binding SoldMedications.Count, Converter={StaticResource PositiveCountToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource CustomerDetailSoldNameHeader}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource CustomerDetailSoldQtyHeader}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                    <TextBlock Grid.Column="2" Text="{DynamicResource CustomerDetailSoldRevenueHeader}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SoldMedications}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource BodyLarge}" Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding TotalQuantity, StringFormat={}{0:0.##}}" Style="{StaticResource BodyLarge}" Foreground="{DynamicResource OnSurfaceBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding TotalRevenue, StringFormat={}{0:0.00}}" Style="{StaticResource BodyLarge}" Foreground="{DynamicResource OnSurfaceBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Record a stock check -->
                        <TextBlock Text="{DynamicResource CustomerDetailAddStockCheckTitle}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource CustomerDetailAddStockCheckSubtitle}"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <Border Background="{DynamicResource SurfaceContainerBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,24">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource CustomerDetailMedicationLabel}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding AvailableMedications}"
                                                  SelectedItem="{Binding SelectedMedication}"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource ThemedComboBoxStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource CustomerDetailQuantityLabel}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding QuantityInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ThemedTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource CustomerDetailBatchLabel}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding BatchInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ThemedTextBoxStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource CustomerDetailExpiryLabel}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ExpiryInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ThemedTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{DynamicResource CustomerDetailNotesLabel}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NotesInput, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ThemedTextBoxStyle}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Height="60"
                                         Margin="0,0,0,12" />

                                <Button Content="{DynamicResource CustomerDetailSaveButton}"
                                        Command="{Binding SaveStockCheckCommand}"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Foreground="{DynamicResource OnPrimaryBrush}"
                                        Template="{StaticResource SelectableButtonTemplate}"
                                        Padding="0,12"
                                        HorizontalContentAlignment="Center" />

                                <TextBlock Text="{Binding StatusMessage}"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Stock check history -->
                        <TextBlock Text="{DynamicResource CustomerDetailStockHistoryTitle}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="{DynamicResource CustomerDetailStockHistoryNone}"
                                   Style="{StaticResource BodyLarge}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,20"
                                   Visibility="{Binding StockCheckHistory.Count, Converter={StaticResource CountToVisibilityConverter}}" />

                        <Border Background="{DynamicResource SurfaceContainerBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,20"
                                Visibility="{Binding StockCheckHistory.Count, Converter={StaticResource PositiveCountToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource CustomerDetailSoldNameHeader}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource CustomerDetailStockQtyHeader}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                    <TextBlock Grid.Column="2" Text="{DynamicResource CustomerDetailStockBatchHeader}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                    <TextBlock Grid.Column="3" Text="{DynamicResource CustomerDetailStockExpiryHeader}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                    <TextBlock Grid.Column="4" Text="{DynamicResource CustomerDetailStockDateHeader}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding StockCheckHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding MedicationName}" Style="{StaticResource BodyLarge}" Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0:0.##}}" Style="{StaticResource BodyLarge}" Foreground="{DynamicResource OnSurfaceBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding BatchNumber}" Style="{StaticResource BodyLarge}" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="3" Text="{Binding ExpiryDate}" Style="{StaticResource BodyLarge}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                                <TextBlock Grid.Column="4" Text="{Binding CheckDate}" Style="{StaticResource BodyLarge}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Add a manual credit (added 2026-08-31) -- e.g. a
                             refund or goodwill credit not tied to any actual
                             payment. See CustomerDetailViewModel.
                             AddManualCreditCommand. -->
                        <TextBlock Text="{DynamicResource CustomerDetailAddCreditTitle}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   Margin="0,0,0,12" />
                        <Border Background="{DynamicResource SurfaceContainerBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,24">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource CustomerDetailCreditAmountLabel}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding CreditAmountInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ThemedTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource CustomerDetailCreditNoteLabel}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding CreditNoteInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ThemedTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="{DynamicResource CustomerDetailAddCreditButton}"
                                        Command="{Binding AddManualCreditCommand}"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Foreground="{DynamicResource OnPrimaryBrush}"
                                        Template="{StaticResource SelectableButtonTemplate}"
                                        Padding="0,12"
                                        HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Payment history (added 2026-08-31) -- every
                             payment/credit ever recorded for this customer,
                             newest first, each with a Revert button unless
                             it's already been reverted. See
                             CustomerDetailViewModel.PaymentHistory/
                             RevertPaymentCommand. -->
                        <TextBlock Text="{DynamicResource CustomerDetailPaymentHistoryTitle}"
                                   Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="{DynamicResource CustomerDetailPaymentHistoryNone}"
                                   Style="{StaticResource BodyLarge}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,20"
                                   Visibility="{Binding PaymentHistory.Count, Converter={StaticResource CountToVisibilityConverter}}" />

                        <Border Background="{DynamicResource SurfaceContainerBrush}"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,0,20"
                                Visibility="{Binding PaymentHistory.Count, Converter={StaticResource PositiveCountToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding PaymentHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource OutlineVariantBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Type}" Style="{StaticResource BodyLarge}" Foreground="{DynamicResource OnSurfaceBrush}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding Amount, StringFormat={}{0:0.00}}" Style="{StaticResource BodyLarge}" Foreground="{DynamicResource OnSurfaceBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PaymentDate}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding PaymentTime}" Style="{StaticResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Notes}"
                                                               Style="{StaticResource LabelSmall}"
                                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{DynamicResource CustomerDetailRevertedTag}"
                                                               Style="{StaticResource LabelSmall}"
                                                               Foreground="{DynamicResource ErrorBrush}"
                                                               Visibility="{Binding IsReverted, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="{DynamicResource CustomerDetailRevertButton}"
                                                        Command="{Binding DataContext.RevertPaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="{DynamicResource ErrorContainerBrush}"
                                                        Foreground="{DynamicResource OnErrorContainerBrush}"
                                                        Template="{StaticResource SelectableButtonTemplate}"
                                                        Padding="10,6"
                                                        VerticalAlignment="Top"
                                                        Visibility="{Binding IsReverted, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
