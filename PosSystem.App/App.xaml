<Application x:Class="PosSystem.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PosSystem.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Default FlowDirection — LocalizationManager.SwitchLanguage
                 overwrites this entry directly (not via dictionary swap,
                 since it's a single value, not a themed set of keys) when
                 Arabic is selected. Screens bind to it via
                 FlowDirection="{DynamicResource AppFlowDirection}". -->
            <FlowDirection x:Key="AppFlowDirection">LeftToRight</FlowDirection>

            <!-- Visibility pair for language-specific layouts that can't rely
                 on FlowDirection auto-mirroring (e.g. reordering, not just
                 mirroring, a row of controls). LocalizationManager.SwitchLanguage
                 sets both directly, same pattern as AppFlowDirection above. -->
            <Visibility x:Key="EnglishOnlyVisibility">Visible</Visibility>
            <Visibility x:Key="ArabicOnlyVisibility">Collapsed</Visibility>

            <!-- Small, single-purpose converters used by Checkout (out-of-stock
                 dimming/disabling, empty-cart message visibility) and
                 Customers (balance badge text, payment-row visibility). Kept
                 as plain keyed resources rather than a merged dictionary
                 since there's no XAML markup around them, just C# classes. -->
            <conv:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <conv:PositiveCountToVisibilityConverter x:Key="PositiveCountToVisibilityConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:CustomerBalanceTextConverter x:Key="CustomerBalanceTextConverter" />

            <ResourceDictionary.MergedDictionaries>
                <!-- Colors.Light.xaml is the startup default (POS counters are usually in
                     bright rooms). ThemeManager.SwitchTheme() swaps this entry for
                     Colors.Dark.xaml at runtime — see Theming/ThemeManager.cs. -->
                <ResourceDictionary Source="Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/NavStyles.xaml" />
                <ResourceDictionary Source="Themes/CheckoutStyles.xaml" />
                <ResourceDictionary Source="Themes/CommonStyles.xaml" />

                <!-- Strings.English.xaml is the startup default.
                     LocalizationManager.SwitchLanguage() swaps this entry for
                     Strings.Arabic.xaml at runtime — see
                     Localization/LocalizationManager.cs. -->
                <ResourceDictionary Source="Localization/Strings.English.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
