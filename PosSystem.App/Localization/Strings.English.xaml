    <system:String x:Key="BillsBrowserViewButton">View</system:String>
    <system:String x:Key="BillsBrowserWalkInLabel">Walk-in</system:String>
    <!-- "Edited" tag shown on a bill list card for a superseded revision
         (Core.Models.Bills.IsCurrent == false) — makes clear #210 and
         #210-e1 in the list are the same receipt at two points in time. -->
    <system:String x:Key="BillsBrowserSupersededTag">Edited — see current version</system:String>
    <!-- Read-only history banner shown at the top of a superseded bill's
         detail view, replacing the normal return actions. -->
    <system:String x:Key="BillsBrowserSupersededBanner">This is an earlier version of this receipt. It's kept as history and can't be changed here.</system:String>
    <system:String x:Key="BillsBrowserViewCurrentButton">View current version</system:String>
    <system:String x:Key="BillsDetailBackButton">← Back to Bills</system:String>
    <system:String x:Key="BillsDetailItemsTitle">Items</system:String>
    <system:String x:Key="BillsDetailRemoveLineButton">Return</system:String>
    <system:String x:Key="BillsDetailReturnWholeBillButton">Return Whole Bill</system:String>
    <system:String x:Key="BillsAdminLockedTitle">Owner/Manager Access Required</system:String>
    <system:String x:Key="BillsAdminLockedSubtitle">Returning a product or a whole bill requires the admin password.</system:String>
    <system:String x:Key="BillsAdminRequired">Enter the admin password below to make this change.</system:String>
    <!-- {0} = product name, {1} = the ORIGINAL bill's display number (e.g.
         "210") — the new revision this creates always gets the next "eN"
         suffix automatically, so the message names the receipt someone
         actually recognizes rather than the freshly-minted "210-e1" they
         haven't seen yet. -->
    <system:String x:Key="BillsDeleteLineSuccess">{0} returned from Bill #{1} — a new receipt was created to reflect it.</system:String>
