<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--
        ENGLISH strings — startup default. Strings.Arabic.xaml defines the
        identical set of keys, so LocalizationManager can hot-swap this
        dictionary for that one at runtime without any screen needing to
        know which language is active. Every screen should bind only to
        these keys via DynamicResource, never a hardcoded literal.
    -->

    <system:String x:Key="NavDashboard">Dashboard</system:String>
    <system:String x:Key="NavCheckout">Checkout</system:String>
    <system:String x:Key="NavCustomers">Customers</system:String>
    <system:String x:Key="NavInventory">Inventory</system:String>
    <system:String x:Key="NavSettings">Settings</system:String>

    <system:String x:Key="DashboardHeading">Dashboard</system:String>
    <system:String x:Key="DashboardDescription">Sold-items and monthly-revenue charts land here in a later step — refreshed per order, per the business plan.</system:String>

    <system:String x:Key="CheckoutHeading">Checkout</system:String>
    <system:String x:Key="CheckoutDescription">Highest-traffic screen — item grid + running order + Cash/Card toggle. Built next.</system:String>
    <system:String x:Key="CheckoutAllCategory">All</system:String>
    <system:String x:Key="CheckoutCartTitle">Current Order</system:String>
    <system:String x:Key="CheckoutCartEmpty">Cart is empty — tap an item to add it.</system:String>
    <system:String x:Key="CheckoutTotal">Total</system:String>
    <system:String x:Key="CheckoutCash">Cash</system:String>
    <system:String x:Key="CheckoutCard">Card</system:String>
    <system:String x:Key="CheckoutCompleteSale">Complete Sale</system:String>
    <system:String x:Key="CheckoutSaleSuccess">Sale completed — Bill #{0}</system:String>
    <system:String x:Key="CheckoutSaleError">Something went wrong saving the sale. Please try again.</system:String>
    <system:String x:Key="CheckoutCustomerLabel">Customer</system:String>
    <system:String x:Key="CheckoutWalkIn">Walk-in (no customer)</system:String>
    <system:String x:Key="CheckoutPayLater">Pay Later</system:String>
    <system:String x:Key="CheckoutPayLaterRequiresCustomer">Select a customer before choosing Pay Later.</system:String>
    <system:String x:Key="CheckoutSaleSuccessCredit">Sale completed — Bill #{0}, added to {1}'s tab.</system:String>

    <system:String x:Key="CustomersHeading">Customers</system:String>
    <system:String x:Key="CustomersAddSectionTitle">Add a customer</system:String>
    <system:String x:Key="CustomersNameField">Name</system:String>
    <system:String x:Key="CustomersPhoneField">Phone</system:String>
    <system:String x:Key="CustomersCodeField">Customer code (optional)</system:String>
    <system:String x:Key="CustomersAddButton">Add customer</system:String>
    <system:String x:Key="CustomersAddMissingName">Enter a name before adding this customer.</system:String>
    <system:String x:Key="CustomersAddSuccess">Customer added.</system:String>
    <system:String x:Key="CustomersAddError">Something went wrong. Please try again.</system:String>
    <system:String x:Key="CustomersListTitle">Customers</system:String>
    <system:String x:Key="CustomersSearchLabel">Search by name, phone, or code</system:String>
    <system:String x:Key="CustomersNoResults">No customers yet — add the first one on the left.</system:String>
    <system:String x:Key="CustomersBalancePaidUp">Paid up</system:String>
    <system:String x:Key="CustomersBalanceOwes">Owes {0:0.00}</system:String>
    <system:String x:Key="CustomersPaymentAmountLabel">Payment amount</system:String>
    <system:String x:Key="CustomersRecordPaymentButton">Record payment</system:String>
    <system:String x:Key="CustomersPaymentSuccess">Payment recorded for {0}.</system:String>
    <system:String x:Key="CustomersPaymentInvalid">Enter a valid payment amount.</system:String>

    <system:String x:Key="InventoryHeading">Inventory</system:String>
    <system:String x:Key="InventoryDescription">Goods list, stock levels, pricing. 281 real products already in rovaShop.db to build against.</system:String>

    <system:String x:Key="SettingsHeading">Settings</system:String>
    <system:String x:Key="SettingsDescription">App-wide preferences live here. Language is the first one — printer setup, receipt footer, tax rate, etc. get added as the client needs them.</system:String>
    <system:String x:Key="LanguageToggleLabel">Toggle Language / تبديل اللغة</system:String>

</ResourceDictionary>
