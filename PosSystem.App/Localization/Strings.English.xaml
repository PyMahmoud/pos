    <!-- Bills browser (#6, 2026-08-27/28; reworked 2026-08-28 into
         receipt revisioning per Mahmoud's explicit request) — opened from
         a button above the customer picker on Checkout. Shows every bill
         AND every past revision of it (the receipt's full history), drill
         into one to see its line items. Returning a product (a single
         line, part of a line's quantity, or the whole bill) never edits
         that bill in place any more — it creates a NEW bill carrying the
         SAME number plus a suffix ("210" -> "210-e1" -> "210-e2"...) and
         leaves the original exactly as it was, as history. Only the
         current/latest revision of a receipt can be returned from; an
         older one opens read-only. All of this requires the admin
         password — see BillsBrowserViewModel's class doc comment for the
         full reversal design. -->
    <system:String x:Key="CheckoutBillsButton">Bills</system:String>
    <system:String x:Key="BillsBrowserTitle">Bills</system:String>
    <system:String x:Key="BillsBrowserCloseButton">✕</system:String>
