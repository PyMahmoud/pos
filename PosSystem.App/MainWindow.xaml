<Window x:Class="PosSystem.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PosSystem" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">

    <!--
        Empty shell on purpose. Build real navigation (a NavigationView /
        sidebar shell is the natural fit for Material-style POS screens:
        Checkout, Customers, Inventory, Dashboard) now that the theme is settled.

        ThemeToggleButton below is a throwaway proof that Light/Dark switching
        works end to end — remove once a real Settings screen owns this.
    -->
    <Grid>
        <TextBlock x:Name="StatusText"
                   Text="PosSystem — skeleton running"
                   Style="{StaticResource HeadlineMedium}"
                   Foreground="{StaticResource OnSurfaceBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center" />

        <Button x:Name="ThemeToggleButton"
                Content="Toggle Light / Dark"
                Click="ThemeToggleButton_Click"
                Background="{StaticResource PrimaryBrush}"
                Foreground="{StaticResource OnPrimaryBrush}"
                BorderThickness="0"
                Padding="16,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,32" />
    </Grid>
</Window>
