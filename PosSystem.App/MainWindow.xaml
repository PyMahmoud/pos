<Window x:Class="PosSystem.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PosSystem.App.ViewModels"
        Title="PosSystem" Height="768" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource OutlineVariantBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <!-- Logo / app name -->
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="16,20,16,16">
                    <Border Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="P"
                                   Foreground="{DynamicResource OnPrimaryBrush}"
                                   FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PosSystem"
                               Style="{StaticResource TitleMedium}"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Theme toggle — throwaway location, move into a real
                     Settings screen once one exists. Icon-free on purpose
                     (no font dependency); label says which way it switches.
                     Uses ThemeToggleButtonStyle (NavStyles.xaml) instead of
                     the default WPF Button template, which paints its own
                     fixed system hover color and was unreadable in dark mode. -->
                <Button x:Name="ThemeToggleButton"
                        DockPanel.Dock="Bottom"
                        Content="Toggle Light / Dark"
                        Click="ThemeToggleButton_Click"
                        Style="{StaticResource ThemeToggleButtonStyle}"
                        Padding="12,10"
                        Margin="12,8,12,16"
                        HorizontalContentAlignment="Center" />

                <!-- Nav items -->
                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="12,0,12,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource NavListBoxItemStyle}" />
            </DockPanel>
        </Border>

        <!-- Active screen -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
    </Grid>
</Window>