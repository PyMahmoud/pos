<Window x:Class="PosSystem.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PosSystem.App.ViewModels"
        Title="PosSystem" Height="768" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FlowDirection="{DynamicResource AppFlowDirection}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource OutlineVariantBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <!-- Logo / app name -->
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="16,20,16,16">
                    <Border Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="P"
                                   Foreground="{DynamicResource OnPrimaryBrush}"
                                   FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PosSystem"
                               Style="{StaticResource TitleMedium}"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Theme toggle — left exactly as it was, untouched. -->
                <Button x:Name="ThemeToggleButton"
                        DockPanel.Dock="Bottom"
                        Content="Toggle Light / Dark"
                        Click="ThemeToggleButton_Click"
                        Style="{StaticResource ThemeToggleButtonStyle}"
                        Padding="12,10"
                        Margin="12,8,12,16"
                        HorizontalContentAlignment="Center" />

                <!-- Nav items -->
                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="12,0,12,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource NavListBoxItemStyle}" />
            </DockPanel>
        </Border>

        <!-- Active screen -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />

        <!-- Unsaved Inventory changes confirmation (2026-09-03) -- see
             MainViewModel.SelectedNavItem's setter for when this shows.
             Spans both columns (sidebar + content), not just the content
             area, since leaving the sidebar clickable underneath would let
             someone pick yet another item while this is already open. -->
        <Border Grid.Column="0" Grid.ColumnSpan="2"
                Background="#99000000"
                Visibility="{Binding IsShowingUnsavedChangesPrompt, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource SurfaceContainerHighBrush}"
                    CornerRadius="16"
                    Padding="24"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource InventoryUnsavedChangesTitle}"
                               Style="{StaticResource TitleMedium}"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource InventoryUnsavedChangesMessage}"
                               Style="{StaticResource BodyLarge}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="{DynamicResource InventoryUnsavedChangesCancelButton}"
                                Command="{Binding ConfirmCancelCommand}"
                                Background="{DynamicResource SurfaceContainerHighestBrush}"
                                Foreground="{DynamicResource OnSurfaceBrush}"
                                Template="{StaticResource SelectableButtonTemplate}"
                                Padding="0,10"
                                HorizontalContentAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="{DynamicResource InventoryUnsavedChangesDiscardButton}"
                                Command="{Binding ConfirmDiscardCommand}"
                                Background="{DynamicResource ErrorContainerBrush}"
                                Foreground="{DynamicResource OnErrorContainerBrush}"
                                Template="{StaticResource SelectableButtonTemplate}"
                                Padding="0,10"
                                HorizontalContentAlignment="Center" />
                        <Button Grid.Column="4"
                                Content="{DynamicResource InventoryUnsavedChangesSaveButton}"
                                Command="{Binding ConfirmSaveCommand}"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="{DynamicResource OnPrimaryBrush}"
                                Template="{StaticResource SelectableButtonTemplate}"
                                Padding="0,10"
                                HorizontalContentAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
